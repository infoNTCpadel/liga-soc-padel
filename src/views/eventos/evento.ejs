<p class="small"><a href="/eventos">← Todos los eventos</a></p>
<div class="ev-head">
  <div class="ev-main">
    <h1><%= ev.name %></h1>
    <p><span class="badge cat"><%= formatName(ev.format) %></span>
      <span>📅 <strong><%= fmtDate(ev.event_date) %></strong><%= ev.event_time ? ' · ' + ev.event_time : '' %></span>
      <span> · 💶 <strong><%= priceLabel(ev) %></strong></span></p>
    <% if (ev.description) { %><div class="card"><p class="ev-desc"><%= ev.description %></p></div><% } %>
    <p class="small mut"><%= inscritos %> inscrito(s)<%= left !== null ? ` · ${left} plazas libres` : '' %></p>
  </div>
  <% if (ev.poster) { %>
  <div class="ev-poster">
    <a href="/eventos/<%= ev.slug %>/poster?v=<%= ev.poster %>" target="_blank" rel="noopener" title="Ver el cartel a tamaño completo">
      <img src="/eventos/<%= ev.slug %>/poster?v=<%= ev.poster %>" alt="Cartel de <%= ev.name %>">
    </a>
  </div>
  <% } %>
</div>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<% if (ok) { %>
<div class="card">
  <h3>¡Apuntado/a! 🎾</h3>
  <p>Tu inscripción está registrada. ¡Nos vemos en el evento!</p>
  <p><a class="btn small" href="/eventos">Ver más eventos</a></p>
</div>
<% } else if (ev.status === 'en_juego') { %>
<div class="card"><p><span class="badge info">En juego 🎾</span> <span class="mut">Este evento ya está en marcha.</span></p></div>
<% } else if (ev.status === 'cerrada') { %>
<div class="card"><p><span class="badge warn">Inscripciones cerradas</span></p></div>
<% } else if (ev.status === 'finalizada') { %>
<div class="card"><p><span class="badge">Finalizado</span> <span class="mut">Este evento ya terminó. ¡Gracias por participar!</span></p></div>
<% } else if (left !== null && left <= 0) { %>
<div class="card"><p><span class="badge warn">Completo</span> <span class="mut">Ya no quedan plazas.</span></p></div>
<% } else { %>
<% const fv = (n) => (form && form[n] != null ? form[n] : ''); %>
<% const fsel = (n, v) => (form && String(form[n]) === String(v) ? 'selected' : ''); %>
<% const f1 = (s) => ev.inscription_mode === 'individual' ? s : 'p1_' + s; %>
<div class="card" style="max-width: 560px">
  <% if (ev.inscription_mode === 'individual') { %>
  <h3>Apuntarme</h3>
  <% } else if (ev.inscription_mode === 'pairs') { %>
  <h3>Apuntar a la pareja</h3>
  <% } else { %>
  <h3>Apuntarme</h3>
  <div class="field"><label>¿Cómo os apuntáis?</label>
    <label class="small"><input type="radio" name="kind" value="solo" <%= fv('kind') !== 'pareja' ? 'checked' : '' %>> Voy solo/a</label>
    <label class="small"><input type="radio" name="kind" value="pareja" <%= fv('kind') === 'pareja' ? 'checked' : '' %>> Vamos en pareja</label>
  </div>
  <% } %>
  <p class="small mut">¿Ya eres socio/a o has jugado antes en el club? Escribe tu móvil y pulsa «Reconocerme» en tu bloque: si te tenemos fichado/a, rellenamos tu nombre y tu nivel solos. El precio de socio se aplica automáticamente al inscribirte.</p>
  <form method="post" action="/eventos/<%= ev.slug %>/inscribir" id="f-insc">
    <% if (ev.inscription_mode === 'mixed') { %><input type="hidden" name="kind" value="<%= fv('kind') || 'solo' %>" id="f-kind"><% } %>
    <div id="f-p1">
      <h4><%= ev.inscription_mode === 'individual' ? 'Tus datos' : 'Jugador 1' %></h4>
      <div class="row2">
        <div class="field"><label>Nombre *</label><input type="text" name="<%= f1('name') %>" value="<%= fv(f1('name')) %>" required></div>
        <div class="field"><label>Teléfono móvil *</label><input type="tel" name="<%= f1('phone') %>" value="<%= fv(f1('phone')) %>" required></div>
      </div>
      <p class="small"><button type="button" class="btn small ghost rec-btn" data-pfx="<%= ev.inscription_mode === 'individual' ? '' : 'p1' %>">🔍 Reconocerme con mi móvil</button> <span class="rec-msg" data-pfx="<%= ev.inscription_mode === 'individual' ? '' : 'p1' %>"></span></p>
      <div class="row2">
        <div class="field"><label>Nivel *</label>
          <select name="<%= f1('level') %>" required>
            <option value="">—</option>
            <% for (const o of levelOptions) { %><option value="<%= o.value %>" <%= fsel(f1('level'), o.value) %>><%= o.name %></option><% } %>
          </select>
        </div>
        <div class="field"><label>Sexo</label>
          <select name="<%= f1('gender') %>"><option value="">—</option><option value="M" <%= fsel(f1('gender'), 'M') %>>Hombre</option><option value="F" <%= fsel(f1('gender'), 'F') %>>Mujer</option></select>
        </div>
      </div>
      <div class="row2">
        <div class="field"><label>Nº de socio <span class="hint">(si lo tienes)</span></label><input type="text" name="<%= f1('member_no') %>" value="<%= fv(f1('member_no')) %>"></div>
        <div class="field"><label>Email</label><input type="email" name="<%= f1('email') %>" value="<%= fv(f1('email')) %>"></div>
      </div>
    </div>
    <% if (ev.inscription_mode !== 'individual') { %>
    <div id="f-p2" style="<%= ev.inscription_mode === 'pairs' || fv('kind') === 'pareja' ? '' : 'display:none' %>">
      <h4>Jugador 2</h4>
      <div class="row2">
        <div class="field"><label>Nombre *</label><input type="text" name="p2_name" value="<%= fv('p2_name') %>"></div>
        <div class="field"><label>Teléfono móvil *</label><input type="tel" name="p2_phone" value="<%= fv('p2_phone') %>"></div>
      </div>
      <p class="small"><button type="button" class="btn small ghost rec-btn" data-pfx="p2">🔍 Reconocerme con mi móvil</button> <span class="rec-msg" data-pfx="p2"></span></p>
      <div class="row2">
        <div class="field"><label>Nivel *</label>
          <select name="p2_level">
            <option value="">—</option>
            <% for (const o of levelOptions) { %><option value="<%= o.value %>" <%= fsel('p2_level', o.value) %>><%= o.name %></option><% } %>
          </select>
        </div>
        <div class="field"><label>Sexo</label>
          <select name="p2_gender"><option value="">—</option><option value="M" <%= fsel('p2_gender', 'M') %>>Hombre</option><option value="F" <%= fsel('p2_gender', 'F') %>>Mujer</option></select>
        </div>
      </div>
      <div class="row2">
        <div class="field"><label>Nº de socio <span class="hint">(si lo tiene)</span></label><input type="text" name="p2_member_no" value="<%= fv('p2_member_no') %>"></div>
        <div class="field"><label>Email</label><input type="email" name="p2_email" value="<%= fv('p2_email') %>"></div>
      </div>
    </div>
    <% } %>
    <button class="btn" type="submit">Inscribirme<% if (!hasDualPrice && ev.price_cents > 0) { %> · <%= eur(ev.price_cents) %> / pers.<% } %></button>
  </form>
  <% if (priceLabel(ev) !== 'Gratis') { %><p class="small mut">El pago se realiza en el club.<% if (hasDualPrice) { %> Te aplicamos el precio según seas socio/a o no: te reconocemos por tu teléfono o tu nº de socio.<% } %></p><% } %>
</div>
<% if (ev.inscription_mode === 'mixed') { %>
<script>
(function () {
  var kind = document.getElementById('f-kind');
  var p2 = document.getElementById('f-p2');
  document.querySelectorAll('input[name="kind"]').forEach(function (r) {
    r.addEventListener('change', function () {
      var isPair = this.value === 'pareja';
      kind.value = this.value;
      p2.style.display = isPair ? 'block' : 'none';
      ['p2_name', 'p2_phone', 'p2_level'].forEach(function (n) {
        var el = document.querySelector('[name="' + n + '"]');
        if (el) el.required = isPair;
      });
    });
  });
})();
</script>
<% } %>
<script>
// Reconocimiento por móvil: rellena nombre, nivel y sexo desde la ficha del club.
document.querySelectorAll('.rec-btn').forEach(function (btn) {
  btn.addEventListener('click', async function () {
    var pfx = btn.getAttribute('data-pfx');
    var key = pfx ? pfx + '_' : '';
    var msg = document.querySelector('.rec-msg[data-pfx="' + pfx + '"]');
    var phoneEl = document.querySelector('[name="' + key + 'phone"]');
    var phone = phoneEl ? phoneEl.value.trim() : '';
    if (!phone) { msg.textContent = 'Escribe primero tu móvil.'; return; }
    msg.textContent = 'Buscando…';
    try {
      var r = await fetch('/eventos/api/reconocer?phone=' + encodeURIComponent(phone));
      var j = await r.json();
      if (!j.found) { msg.textContent = 'No te hemos encontrado: rellena tus datos, por favor.'; return; }
      var set = function (n, v) {
        if (v == null || v === '') return;
        var el = document.querySelector('[name="' + key + n + '"]');
        if (el) el.value = v;
      };
      set('name', j.name);
      set('gender', j.gender);
      if (j.level != null) {
        var sel = document.querySelector('select[name="' + key + 'level"]');
        if (sel) {
          var best = null, bd = 1e9;
          for (var i = 0; i < sel.options.length; i++) {
            var v = parseFloat(sel.options[i].value);
            if (!isNaN(v) && Math.abs(v - j.level) < bd) { bd = Math.abs(v - j.level); best = sel.options[i].value; }
          }
          if (best != null) sel.value = best;
        }
      }
      msg.textContent = '¡Hola, ' + (j.name || '') + '! Te hemos reconocido' + (j.socio ? ' como socio/a' : '') + '. Revisa tus datos y pulsa Inscribirme.';
    } catch (e) {
      msg.textContent = 'No se pudo consultar. Rellena tus datos, por favor.';
    }
  });
});
</script>
<% } %>

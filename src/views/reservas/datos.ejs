<h1>Mis datos</h1>
<p class="mut">Socio <strong><%= member.member_no %></strong> · <%= member.name %></p>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (ok) { %><div class="alert ok"><%= ok %></div><% } %>
<div class="card">
  <h3>Teléfono y email</h3>
  <p class="mut">Se usan para avisos (lista de espera y recordatorios).</p>
  <form method="post" action="/reservar/datos/telefono">
    <div class="field"><label>Teléfono</label><input type="tel" name="phone" value="<%= member.phone %>" required></div>
    <div class="field"><label>Email</label><input type="email" name="email" value="<%= member.email %>"></div>
    <button class="btn small" type="submit">Guardar</button>
  </form>
</div>
<div class="card">
  <h3>Mi nivel</h3>
  <p class="mut">Tu partido abierto será visible para jugadores de tu nivel ±1.</p>
  <form method="post" action="/reservar/datos/nivel" class="row2">
    <div class="field"><label>Nivel (opcional)</label>
      <select name="level">
        <option value="">Sin definir</option>
        <% for (let l = 1; l <= 7; l += 0.25) { %>
          <option value="<%= l %>" <%= member.level === l ? 'selected' : '' %>><%= String(l).replace('.', ',') %></option>
        <% } %>
      </select>
    </div>
    <div class="field"><label>&nbsp;</label><button class="btn small" type="submit">Guardar nivel</button></div>
  </form>
</div>
<div class="card">
  <h3>Jugadores bloqueados</h3>
  <p class="mut">No verán tus partidos abiertos.</p>
  <% if (blocks && blocks.length) { %>
  <ul>
    <% for (const bl of blocks) { %>
    <li><%= bl.name %> (socio <%= bl.member_no %>)
      <form method="post" action="/reservar/datos/bloqueos/eliminar" style="display:inline">
        <input type="hidden" name="member_no" value="<%= bl.member_no %>">
        <button class="btn small ghost" type="submit">Quitar</button>
      </form>
    </li>
    <% } %>
  </ul>
  <% } %>
  <form method="post" action="/reservar/datos/bloqueos" class="row2">
    <div class="field"><label>Añadir por nº de socio</label><input type="text" name="member_no" placeholder="p. ej. 1002" required></div>
    <div class="field"><label>&nbsp;</label><button class="btn small" type="submit">Bloquear</button></div>
  </form>
</div>
<div class="card">
  <h3>Cambiar PIN</h3>
  <form method="post" action="/reservar/datos/pin">
    <div class="field"><label>PIN actual</label><input type="password" name="pin_actual" inputmode="numeric" required></div>
    <div class="field"><label>PIN nuevo (4–8 dígitos)</label><input type="password" name="pin" inputmode="numeric" required></div>
    <div class="field"><label>Repite el PIN nuevo</label><input type="password" name="pin2" inputmode="numeric" required></div>
    <button class="btn small" type="submit">Cambiar PIN</button>
  </form>
</div>
<p><a class="btn small ghost" href="/reservar/mis">← Mis reservas</a></p>

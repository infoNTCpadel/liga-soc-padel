<h1>Nueva reserva</h1>
<p class="mut">Fecha: <%= date.slice(8,10) %>/<%= date.slice(5,7) %>/<%= date.slice(0,4) %></p>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<% if (!court) { %>
<div class="card">
  <h3>1. Elige la pista</h3>
  <form method="get" action="<%= action %>" class="row2">
    <input type="hidden" name="date" value="<%= date %>">
    <div class="field"><label>Fecha</label><input type="date" name="date2" value="<%= date %>" disabled></div>
    <div class="field"><label>Pista</label><select name="court" required>
      <% for (const c of courts) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
    </select></div>
    <div class="field"><label>&nbsp;</label><button class="btn" type="submit">Ver huecos libres</button></div>
  </form>
</div>
<% } else if (!seg) { %>
<div class="card">
  <h3>2. Elige el tramo libre — <%= court.name %></h3>
  <% if (!segs || !segs.length) { %><p class="mut">No hay tramos libres ese día.</p><% } %>
  <table class="tbl">
    <% for (const g of (segs || [])) { const vs = g.starts || []; %>
    <tr>
      <td><%= minToStr(g.start) %>–<%= minToStr(g.end) %></td>
      <td class="mut"><%= vs.length %> inicios posibles</td>
      <td><a class="btn small" href="<%= action %>?date=<%= date %>&court=<%= court.id %>&desde=<%= g.start %>">Elegir</a></td>
    </tr>
    <% } %>
  </table>
  <p style="margin-top:.6em"><a class="btn small ghost" href="<%= action %>?date=<%= date %>">← Otra pista</a></p>
</div>
<% } else { %>
<div class="card">
  <h3>3. Reserva — <%= court.name %> · <%= minToStr(seg.start) %>–<%= minToStr(seg.end) %></h3>
  <form method="post" action="<%= action %>">
    <input type="hidden" name="court_id" value="<%= court.id %>">
    <input type="hidden" name="date" value="<%= date %>">
    <input type="hidden" name="desde" value="<%= seg.start %>">
    <div class="field prow" data-i="0">
      <label>Titular (tiene que ser socio)</label>
      <input type="text" class="psearch" placeholder="Nombre, nº de socio o móvil…" autocomplete="off" autofocus>
      <input type="hidden" name="titular_name" class="pname">
      <input type="hidden" name="titular_member_no" class="pmember">
      <div class="plist" style="display:none"></div>
      <div class="pinfo mut" style="font-size:.85em;margin-top:.2em"></div>
    </div>
    <div class="row2">
      <div class="field"><label>Hora de inicio</label>
        <select name="start_min" id="startSel" required>
          <% for (const v of starts) { %>
            <option value="<%= v.start_min %>" data-d="<%= v.durations.join(',') %>"><%= minToStr(v.start_min) %></option>
          <% } %>
        </select>
      </div>
      <div class="field"><label>Duración</label>
        <div id="durRow">
        <% for (const d of config.durations) { %>
          <label style="display:inline-block;margin-right:1em"><input type="radio" name="duration_min" class="durOpt" value="<%= d %>" <%= d === 75 ? 'checked' : '' %>> <%= d %> min</label>
        <% } %>
        </div>
      </div>
    </div>
    <h4>Jugadores (opcional, el titular ya cuenta)</h4>
    <p class="mut">Busca por nombre, nº de socio o móvil y se rellenan los datos. El titular tiene que ser socio; en Jugador 1–3, si escribes un nombre sin elegir socio, contará como invitado.</p>
    <% for (let i = 1; i <= 3; i++) { %>
    <div class="field prow" data-i="<%= i %>">
      <label>Jugador <%= i %></label>
      <input type="text" class="psearch" placeholder="Nombre, nº de socio o móvil…" autocomplete="off">
      <input type="hidden" name="p<%= i %>_name" class="pname">
      <input type="hidden" name="p<%= i %>_member" class="pmember">
      <div class="plist" style="display:none"></div>
      <div class="pinfo mut" style="font-size:.85em;margin-top:.2em"></div>
    </div>
    <% } %>
    <div class="field"><label>Plazas abiertas (partido abierto)</label>
      <select name="open_spots">
        <option value="0">0 · partido cerrado</option>
        <option value="1">1 plaza</option>
        <option value="2">2 plazas</option>
        <option value="3">3 plazas</option>
      </select>
    </div>
    <button class="btn" type="submit">Crear reserva</button>
    <a class="btn ghost" href="<%= backUrl %>" style="margin-left:.5em">Cancelar</a>
  </form>
</div>
<style>
.prow{position:relative;margin-bottom:.7em}
.plist{position:absolute;z-index:5;left:0;right:0;background:#fff;border:1px solid #d8d3e8;border-radius:8px;box-shadow:0 4px 14px rgba(60,40,120,.12);max-height:180px;overflow:auto}
.plist div{padding:.5em .7em;cursor:pointer}
.plist div:hover{background:#f4f1ff}
.pill{display:inline-block;padding:.1em .6em;border-radius:999px;font-size:.8em;font-weight:700}
.pill.socio{background:#e7f6ee;color:#146c39}
.pill.inv{background:#fdf3e3;color:#9a6b1a}
</style>
<script>
(function () {
  const sel = document.getElementById('startSel');
  const opts = document.querySelectorAll('.durOpt');
  function upd() {
    const allowed = (sel.selectedOptions[0].dataset.d || '').split(',').map(Number);
    opts.forEach(o => {
      const on = allowed.includes(Number(o.value));
      o.closest('label').style.display = on ? '' : 'none';
      if (!on && o.checked) o.checked = false;
    });
    if (![...opts].some(o => o.checked && o.closest('label').style.display !== 'none')) {
      const first = [...opts].find(o => o.closest('label').style.display !== 'none');
      if (first) first.checked = true;
    }
  }
  sel.addEventListener('change', upd); upd();

  // Buscador de jugadores (mismo que el formulario del socio).
  const searchBase = '<%= action.replace(/\/nueva$/, "") %>/socios/buscar';
  let timer = null;
  document.querySelectorAll('.prow').forEach(row => {
    const input = row.querySelector('.psearch'), list = row.querySelector('.plist'),
      hname = row.querySelector('.pname'), hmem = row.querySelector('.pmember'),
      info = row.querySelector('.pinfo');
    function paint() {
      const n = hname.value.trim(), m = hmem.value.trim();
      if (!n) { info.innerHTML = ''; return; }
      if (m) { info.innerHTML = '<span class="pill socio">Socio ' + m + '</span>'; return; }
      info.innerHTML = row.dataset.i === '0'
        ? '<span class="pill inv">Elige un socio de la lista</span>'
        : '<span class="pill inv">Invitado</span>';
    }
    function pick(s) {
      hname.value = s.name; hmem.value = s.member_no;
      input.value = s.name + ' (' + s.member_no + ')';
      list.style.display = 'none'; paint();
    }
    input.addEventListener('input', () => {
      hname.value = input.value.trim(); hmem.value = ''; paint();
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) { list.style.display = 'none'; return; }
      timer = setTimeout(() => {
        fetch(searchBase + '?q=' + encodeURIComponent(q))
          .then(r => r.json()).then(arr => {
            if (!arr.length) { list.style.display = 'none'; return; }
            list.innerHTML = '';
            arr.forEach(s => {
              const d = document.createElement('div');
              d.textContent = s.name + ' · socio ' + s.member_no + (s.phone ? ' · ' + s.phone : '');
              d.addEventListener('mousedown', () => pick(s));
              list.appendChild(d);
            });
            list.style.display = '';
          })
          .catch(() => { info.innerHTML = '<span class="pill inv">No se pudo buscar: recarga la página</span>'; });
      }, 250);
    });
    input.addEventListener('blur', () => setTimeout(() => list.style.display = 'none', 200));
    input.addEventListener('focus', () => { if (list.children.length) list.style.display = ''; });
    paint();
  });
})();
</script>
<% } %>

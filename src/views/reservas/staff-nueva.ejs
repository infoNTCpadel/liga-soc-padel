<h1>Nueva reserva</h1>
<p class="mut">Fecha: <%= date.slice(8,10) %>/<%= date.slice(5,7) %>/<%= date.slice(0,4) %></p>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<% if (!court) { %>
<div class="card">
  <h3>1. Elige la pista</h3>
  <form method="get" action="<%= action %>" class="row2">
    <input type="hidden" name="date" value="<%= date %>">
    <div class="field"><label>Fecha</label><input type="date" name="date2" value="<%= date %>" disabled></div>
    <div class="field"><label>Pista</label><select name="court" required>
      <% for (const c of courts) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
    </select></div>
    <div class="field"><label>&nbsp;</label><button class="btn" type="submit">Ver huecos libres</button></div>
  </form>
</div>
<% } else if (!seg) { %>
<div class="card">
  <h3>2. Elige el tramo libre — <%= court.name %></h3>
  <% if (!segs || !segs.length) { %><p class="mut">No hay tramos libres ese día.</p><% } %>
  <table class="tbl">
    <% for (const g of (segs || [])) { const vs = g.starts || []; %>
    <tr>
      <td><%= minToStr(g.start) %>–<%= minToStr(g.end) %></td>
      <td class="mut"><%= vs.length %> inicios posibles</td>
      <td><a class="btn small" href="<%= action %>?date=<%= date %>&court=<%= court.id %>&desde=<%= g.start %>">Elegir</a></td>
    </tr>
    <% } %>
  </table>
  <p style="margin-top:.6em"><a class="btn small ghost" href="<%= action %>?date=<%= date %>">← Otra pista</a></p>
</div>
<% } else { %>
<div class="card">
  <h3>3. Reserva — <%= court.name %> · <%= minToStr(seg.start) %>–<%= minToStr(seg.end) %></h3>
  <form method="post" action="<%= action %>">
    <input type="hidden" name="court_id" value="<%= court.id %>">
    <input type="hidden" name="date" value="<%= date %>">
    <input type="hidden" name="desde" value="<%= seg.start %>">
    <div class="field"><label>Titular (nº de socio)</label><input type="text" name="titular_member_no" inputmode="numeric" required autofocus></div>
    <div class="row2">
      <div class="field"><label>Hora de inicio</label>
        <select name="start_min" id="startSel" required>
          <% for (const v of starts) { %>
            <option value="<%= v.start_min %>" data-d="<%= v.durations.join(',') %>"><%= minToStr(v.start_min) %></option>
          <% } %>
        </select>
      </div>
      <div class="field"><label>Duración</label>
        <div id="durRow">
        <% for (const d of config.durations) { %>
          <label style="display:inline-block;margin-right:1em"><input type="radio" name="duration_min" class="durOpt" value="<%= d %>" <%= d === 75 ? 'checked' : '' %>> <%= d %> min</label>
        <% } %>
        </div>
      </div>
    </div>
    <h4>Jugadores (opcional, el titular ya cuenta)</h4>
    <% for (let i = 1; i <= 3; i++) { %>
    <div class="row2">
      <div class="field"><label>Nombre</label><input type="text" name="p<%= i %>_name"></div>
      <div class="field"><label>Nº de socio</label><input type="text" name="p<%= i %>_member" inputmode="numeric"></div>
    </div>
    <% } %>
    <div class="field"><label>Plazas abiertas (partido abierto)</label>
      <select name="open_spots">
        <option value="0">0 · partido cerrado</option>
        <option value="1">1 plaza</option>
        <option value="2">2 plazas</option>
        <option value="3">3 plazas</option>
      </select>
    </div>
    <button class="btn" type="submit">Crear reserva</button>
    <a class="btn ghost" href="<%= backUrl %>" style="margin-left:.5em">Cancelar</a>
  </form>
</div>
<script>
(function () {
  const sel = document.getElementById('startSel');
  const opts = document.querySelectorAll('.durOpt');
  function upd() {
    const allowed = (sel.selectedOptions[0].dataset.d || '').split(',').map(Number);
    opts.forEach(o => {
      const on = allowed.includes(Number(o.value));
      o.closest('label').style.display = on ? '' : 'none';
      if (!on && o.checked) o.checked = false;
    });
    if (![...opts].some(o => o.checked && o.closest('label').style.display !== 'none')) {
      const first = [...opts].find(o => o.closest('label').style.display !== 'none');
      if (first) first.checked = true;
    }
  }
  sel.addEventListener('change', upd); upd();
})();
</script>
<% } %>

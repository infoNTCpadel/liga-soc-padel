    </div>
    <label class="qcheck"><input type="checkbox" id="qOpen"> <span><strong>Partido abierto</strong><br><span class="mut" style="font-size:.85em">Publicar las plazas libres para que se apunten otros socios.</span></span></label>
    <form id="qForm" method="post" action="<%= staffBase %>/rapida">

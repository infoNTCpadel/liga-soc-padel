<h1>Reservar pista</h1>
<p class="mut">Solo para socios del club. Las reservas se encajan sin dejar huecos: cada tramo libre se reserva desde su inicio (o en horas que dejen el resto rellenable). Si algún jugador no es socio, deberá pagar en recepción antes de jugar.</p>

<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<% if (typeof info !== 'undefined' && info) { %><div class="alert ok"><%= info %></div><% } %>

<div class="card">
  <div class="row2" style="align-items:center">
    <div>
      <% if (prev) { %><a class="btn small ghost" href="/reservar?date=<%= prev %>">← <%= prev.slice(8,10) %>/<%= prev.slice(5,7) %></a><% } %>
      <strong style="margin:0 .6em"><%= date.slice(8,10) %>/<%= date.slice(5,7) %>/<%= date.slice(0,4) %></strong>
      <% if (next) { %><a class="btn small ghost" href="/reservar?date=<%= next %>"><%= next.slice(8,10) %>/<%= next.slice(5,7) %> →</a><% } %>
    </div>
    <div style="text-align:right">
      <% if (member) { %><a class="btn small ghost" href="/reservar/mis">Mis reservas</a> <a class="btn small ghost" href="/reservar/datos">Mis datos</a>
      <% } else { %><a class="btn small" href="/reservar/entrar?next=<%= encodeURIComponent('/reservar?date=' + date) %>">Entrar para reservar</a><% } %>
    </div>
  </div>
</div>

<% if (noCourts) { %>
  <div class="card"><p class="mut">Aún no hay pistas configuradas. El club las está preparando.</p></div>
<% } else { %>
  <% for (const row of grid) { %>
  <div class="card">
    <h3><%= row.court.name %></h3>
    <table class="tbl">
      <tr><th>Tramo</th><th>Estado</th><th></th></tr>
      <% for (const it of row.items) { %>
      <tr>
        <td><%= minToStr(it.start) %>–<%= minToStr(it.end) %></td>
        <td>
          <% if (it.type === 'free') { %><span class="badge ok">Libre</span>
          <% } else if (it.type === 'booked') { %><span class="badge">Ocupado</span>
          <% } else if (it.type === 'blocked') { %><span class="mut" title="<%= it.block.reason %><%= it.block.notes ? ' · ' + it.block.notes : '' %>">Bloqueada</span>
          <% } else { %><span class="mut">—</span><% } %>
        </td>
        <td>
          <% if (it.type === 'free') { %>
            <% if (member) { %><a class="btn small" href="/reservar/nueva?court=<%= row.court.id %>&date=<%= date %>&desde=<%= it.start %>">Reservar</a>
            <% } else { %><a class="btn small" href="/reservar/entrar?next=<%= encodeURIComponent('/reservar/nueva?court=' + row.court.id + '&date=' + date + '&desde=' + it.start) %>">Reservar</a><% } %>
          <% } %>
        </td>
      </tr>
      <% } %>
    </table>
    <% if (waitStarts[row.court.id] && waitStarts[row.court.id].length) { %>
    <details style="margin-top:.6em">
      <summary class="mut" style="cursor:pointer">Avisadme si se libera una hora</summary>
      <% if (member) { %>
      <form method="post" action="/reservar/espera" class="row2" style="margin-top:.5em">
        <input type="hidden" name="court_id" value="<%= row.court.id %>">
        <input type="hidden" name="date" value="<%= date %>">
        <div class="field"><label>Hora deseada</label><select name="start_min" required>
          <% for (const v of waitStarts[row.court.id]) { %><option value="<%= v.start_min %>"><%= minToStr(v.start_min) %></option><% } %>
        </select></div>
        <div class="field"><label>Duración</label><select name="duration_min" required>
          <% for (const d of config.durations) { %><option value="<%= d %>" <%= d === 75 ? 'selected' : '' %>><%= d %> min</option><% } %>
        </select></div>
        <div class="field"><label>&nbsp;</label><button class="btn small" type="submit">Avisadme</button></div>
      </form>
      <% } else { %>
      <p class="mut"><a href="/reservar/entrar">Entra</a> para apuntarte a la lista de espera.</p>
      <% } %>
    </details>
    <% } %>
  </div>
  <% } %>
<p class="hint">Duraciones disponibles: <%= config.durations.join(' y ') %> minutos. Las horas ofrecidas son las que no dejan huecos inservibles.</p>
<% } %>

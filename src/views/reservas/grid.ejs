<% const staff = typeof staffMode !== 'undefined' && staffMode; %>
<h1><%= staff ? 'Parrilla · nueva reserva' : 'Reservar pista' %></h1>
<% if (staff) { %>
<p class="mut">Pulsa una franja libre para crear la reserva como personal (se abre el formulario con pista, fecha y tramo ya elegidos). Pulsa una franja ocupada para ver el detalle en grande debajo.</p>
<% } else { %>
<p class="mut">Solo para socios del club. Para reservar o apuntarte a un partido abierto necesitas entrar con tu nº de socio y PIN. Si algún jugador no es socio, deberá pagar en recepción antes de jugar.</p>
<% } %>

<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<% if (typeof info !== 'undefined' && info) { %><div class="alert ok"><%= info %></div><% } %>

<div class="card">
  <div class="row2" style="align-items:center">
    <div>
      <% if (prev) { %><a class="btn small ghost" href="<%= staff ? staffBase + '/parrilla?date=' + prev : '/reservar?date=' + prev %>">← <%= prev.slice(8,10) %>/<%= prev.slice(5,7) %></a><% } %>
      <strong style="margin:0 .6em"><%= date.slice(8,10) %>/<%= date.slice(5,7) %>/<%= date.slice(0,4) %></strong>
      <% if (next) { %><a class="btn small ghost" href="<%= staff ? staffBase + '/parrilla?date=' + next : '/reservar?date=' + next %>"><%= next.slice(8,10) %>/<%= next.slice(5,7) %> →</a><% } %>
    </div>
    <div style="text-align:right">
      <% if (staff) { %><a class="btn small ghost" href="<%= staffDay %>?date=<%= date %>">Ver reservas del día</a>
      <% } else if (member) { %><a class="btn small ghost" href="/reservar/mis">Mis reservas</a> <a class="btn small ghost" href="/reservar/datos">Mis datos</a>
      <% } else { %><a class="btn small" href="/reservar/entrar?next=<%= encodeURIComponent('/reservar?date=' + date) %>">Entrar para reservar</a><% } %>
    </div>
  </div>
</div>

<div class="daytabs">
  <% for (const t of tabs) { %>
    <a class="daytab<%= t === date ? ' on' : '' %>" href="<%= staff ? staffBase + '/parrilla?date=' + t : '/reservar?date=' + t %>"><%= tabLabel(t) %></a>
  <% } %>
</div>

<% if (typeof closed !== 'undefined' && closed) { %>
  <div class="card"><p class="mut">El club está cerrado este día.</p></div>
<% } else if (noCourts) { %>
  <div class="card"><p class="mut">Aún no hay pistas configuradas. El club las está preparando.</p></div>
<% } else { %>
<style>
.daytabs{display:flex;gap:.4em;overflow-x:auto;margin:.8em 0}
.daytab{flex:0 0 auto;padding:.5em .9em;border:1px solid #d8d3e8;border-radius:999px;background:#fff;color:#4b3d8f;text-decoration:none;font-weight:600}
.daytab.on{background:#5b3df0;color:#fff;border-color:#5b3df0}
.slotwrap{overflow-x:auto;border:1px solid #e5e1f2;border-radius:12px;background:#fff}
table.slots{border-collapse:separate;border-spacing:0;min-width:100%}
table.slots th, table.slots td{padding:.45em .5em;border-bottom:1px solid #f0edf8;text-align:center;white-space:nowrap}
table.slots thead th{background:#faf8ff;color:#4b3d8f;position:sticky;top:0}
table.slots tbody th{color:#6b6884;font-weight:600;background:#fff;position:sticky;left:0}
.chip{display:inline-block;padding:.45em .8em;border-radius:999px;font-size:.85em;font-weight:700;text-decoration:none;min-width:7.5em}
.chip.free{border:1.5px solid #5b3df0;color:#4b3d8f;background:#f4f1ff}
a.chip.free:hover{background:#e9e3ff}
.chip.busy{background:#f1f0f6;color:#b9b6c9}
.chip.open{border:1.5px solid #1e8e4d;color:#146c39;background:#e9f7ef}
a.chip.open:hover{background:#d9f0e3}
.chip.na{background:#faf9fd;color:#d5d2e2}
.legend{display:flex;gap:1em;flex-wrap:wrap;margin:.7em 0;font-size:.85em;color:#6b6884}
.legend i{display:inline-block;width:.9em;height:.9em;border-radius:3px;margin-right:.3em;vertical-align:-1px}
/* Reserva rápida: confirmación en la propia parrilla (2 clics) */
.qmodal{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:200;display:flex;align-items:flex-end;justify-content:center}
.qbox{background:var(--card);color:var(--txt);border:1px solid var(--line);border-radius:16px 16px 0 0;padding:1em 1.1em;width:100%;max-width:34em;max-height:92vh;overflow:auto}
@media(min-width:720px){.qmodal{align-items:center;padding:1em}.qbox{border-radius:16px}}
.qbox h3{margin:.1em 0 .3em;color:var(--txt)}
.qbox .field{margin:.6em 0}
.qbox label.fl{display:block;font-size:.85em;color:var(--mut);margin-bottom:.25em}
.qcheck{display:flex;gap:.5em;align-items:flex-start;margin:.7em 0;font-size:.92em;color:var(--txt)}
.qcheck input{margin-top:.2em}
.prow{position:relative}
.prow .psearch{width:100%;box-sizing:border-box}
.plist{position:absolute;z-index:30;left:0;right:0;background:var(--card2);color:var(--txt);border:1px solid var(--line);border-radius:8px;max-height:11em;overflow:auto;box-shadow:0 8px 20px rgba(0,0,0,.35)}
.plist>div{padding:.45em .6em;cursor:pointer}
.plist>div:hover{background:#2b351f}
.pill{display:inline-block;background:#2b351f;border:1px solid var(--lime);color:var(--lime);border-radius:999px;padding:0 .55em;font-size:.85em;margin:.15em .3em .15em 0;cursor:pointer;font:inherit}
.pill.inv{background:#3a2f14;border-color:var(--amber);color:var(--amber);cursor:default}
<% if (staff) { %>
/* Tema del personal: colores de la app (oscuro + lima) */
.slotwrap{background:var(--card);border-color:var(--line)}
table.slots th, table.slots td{border-bottom:1px solid var(--line);color:var(--txt)}
table.slots thead th{background:var(--card2);color:var(--lime)}
table.slots tbody th{background:var(--card);color:var(--mut)}
.chip.free{border:1.5px solid var(--lime);color:var(--lime);background:transparent}
a.chip.free:hover{background:#2b351f;color:var(--lime)}
.chip.busy{background:#232b1c;color:var(--txt);border:1.5px solid var(--line);cursor:pointer;text-align:left;min-width:9em;font:inherit}
.chip.busy:hover{filter:brightness(1.25)}
.chip.busy.is-open{border-style:dashed}
.chip.busy .rname{display:block;font-size:1em}
.chip.busy .rtime{display:block;font-weight:400;font-size:.78em;color:var(--mut)}
.chip.busy .rchips{display:block;margin-top:2px}
.lchip{display:inline-block;font-size:.72em;font-weight:700;border-radius:6px;padding:1px 7px;margin:1px 2px 1px 0;color:#111;vertical-align:middle}
.lchip.free{background:transparent;border:1.5px dashed var(--amber);color:var(--amber);padding:0 6px}
.ppend{color:var(--amber);font-weight:700}
.legend{color:var(--mut)}
#staffDetail h3{margin-top:0}
#staffDetail ul{margin:.5em 0;padding-left:1.2em}
<% } %>
</style>
<div class="slotwrap"><table class="slots">
  <% const bmap = {}; if (staff && typeof bookings !== 'undefined') { for (const b of bookings) bmap[b.id] = b; } %>
  <thead><tr><th></th><% for (const court of courts) { %><th><%= court.name %></th><% } %></tr></thead>
  <tbody>
  <% for (const row of rows) { %>
    <tr>
      <th><%= minToStr(row.slot) %></th>
      <% for (const { court, cell } of row.cells) {
        if (cell.st === 'free') {
          const url = '/reservar/nueva?court=' + court.id + '&date=' + date + '&desde=' + row.slot + '&duracion=' + cell.duration;
          const href = staff ? staffBase + '/nueva?court=' + court.id + '&date=' + date + '&desde=' + row.slot + '&duracion=' + cell.duration
            : (member ? url : '/reservar/entrar?next=' + encodeURIComponent(url));
      %><td><a class="chip free" href="<%= href %>" data-cname="<%= court.name %>" data-qdate="<%= staff ? dateStr : date.slice(8,10) + '/' + date.slice(5,7) %>" data-start="<%= minToStr(row.slot) %>" data-end="<%= minToStr(row.slot + cell.duration) %>" title="<%= cell.duration %> minutos"><%= staff ? 'Libre · ' + cell.duration + ' min' : court.name + ' · libre' %></a></td><%
        } else if ((cell.st === 'open' || cell.st === 'busy') && staff && cell.booking && bmap[cell.booking.id]) {
          const b = bmap[cell.booking.id];
          const chips = cardChips(b);
          const cc = bookingColor(b);
          const isOpen = b.open_spots > 0;
          const bname = b.titular_name;
      %><td><button type="button" class="chip busy<%= isOpen ? ' is-open' : '' %>" data-bid="<%= b.id %>" style="border-color:<%= cc %>;background:<%= cc %>1f" title="<%= isOpen ? 'Partido abierto · ' : '' %><%= bname %> · <%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %> — pulsa para ver el detalle">
        <span class="rname"><%= bname %></span>
        <span class="rtime"><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %><% if (isOpen) { %> · abierto<% } %><% if (b.payment_status === 'pending') { %> <span class="ppend" title="Pago pendiente">●</span><% } %></span>
        <span class="rchips"><% for (const ch of chips) { %><% if (ch.free) { %><span class="lchip free">+</span><% } else { %><span class="lchip" style="background:<%= levelColor(ch.level) %>"><%= ch.level %></span><% } %><% } %></span>
      </button></td><%
        } else if (cell.st === 'blocked' && staff) {
          const breason = (cell.block && cell.block.reason) || 'Bloqueo';
      %><td><span class="chip busy" style="border-color:#9aa88f;background:#9aa88f1f;cursor:default" title="<%= breason %>">Bloqueo</span></td><%
        } else if (cell.st === 'open') {
          const openHref = staff ? staffDay + '?date=' + date : '/reservar/abierto/' + cell.booking.id;
      %><td><a class="chip open" href="<%= openHref %>"><%= court.name %> · <%= cell.booking.open_spots %> <%= cell.booking.open_spots === 1 ? 'plaza' : 'plazas' %><%= cell.range ? ' · ' + cell.range : '' %></a></td><%
        } else if (cell.st === 'busy' || cell.st === 'blocked') {
      %><td><span class="chip busy"><%= court.name %> · ocupada</span></td><%
        } else if (cell.st === 'past') {
      %><td><span class="chip na" title="Franja pasada"><%= minToStr(row.slot) %></span></td><%
        } else {
      %><td><span class="chip na" title="No encaja sin dejar huecos">—</span></td><%
        }
      } %>
    </tr>
  <% } %>
  </tbody>
</table></div>
<div class="legend">
<% if (staff) { %>
  <span><i style="background:transparent;border:1.5px solid var(--lime)"></i>Libre (pulsa para reservar)</span>
  <span><i style="background:#f871711f;border:1.5px solid #f87171"></i>Reservada (pulsa para ver el detalle)</span>
  <span><i style="background:#60a5fa1f;border:1.5px dashed #60a5fa"></i>Partido abierto (faltan jugadores)</span>
  <span><i style="background:#9aa88f1f;border:1.5px solid #9aa88f"></i>Bloqueo</span>
  <span><span class="ppend">●</span> Pago pendiente</span>
<% } else { %>
  <span><i style="background:#f4f1ff;border:1.5px solid #5b3df0"></i>Libre (pulsa para reservar)</span>
  <span><i style="background:#e9f7ef;border:1.5px solid #1e8e4d"></i>Partido abierto (faltan jugadores)</span>
  <span><i style="background:#f1f0f6"></i>Ocupada</span>
<% } %>
</div>
<p class="hint"><%= staff ? 'Pulsa una franja libre para la reserva rápida (2 clics). Pulsa una ocupada para ver el detalle en grande.' : 'Franjas de ' + config.durations.slice().sort((a,b) => b-a)[0] + ' minutos. Al pulsar una franja libre se abre la confirmación rápida (2 clics).' %></p>
<% if (!staff && member) { %>
<div id="qModal" class="qmodal" style="display:none" role="dialog" aria-modal="true" aria-label="Confirmar reserva">
  <div class="qbox">
    <h3>Confirmar reserva</h3>
    <p class="mut" id="qSummary" style="margin-top:0"></p>
    <p style="font-size:.92em">Titular: <strong><%= member.name %></strong> <span class="mut">(socio <%= member.member_no %>)</span></p>
    <label class="qcheck"><input type="checkbox" id="qOpen" checked> <span><strong>Partido abierto</strong><br><span class="mut" style="font-size:.85em">Si no añades jugadores, otros socios de tu nivel podrán apuntarse desde la parrilla.</span></span></label>
    <form id="qForm" method="post" action="/reservar/rapida">
      <input type="hidden" name="court_id" id="qCourt">
      <input type="hidden" name="date" value="<%= date %>">
      <input type="hidden" name="start_min" id="qStart">
      <input type="hidden" name="duration_min" id="qDur">
      <input type="hidden" name="abrir" id="qAbrir" value="1">
      <div class="row2" style="align-items:center;margin-top:.6em">
        <div><a href="#" id="qFull" class="mut" style="font-size:.85em">Añadir jugadores…</a></div>
        <div style="text-align:right">
          <button type="button" class="btn small ghost" id="qCancel">Cancelar</button>
          <button type="submit" class="btn small">Confirmar reserva</button>
        </div>
      </div>
    </form>
  </div>
</div>
<% } %>
<% if (staff) { %>

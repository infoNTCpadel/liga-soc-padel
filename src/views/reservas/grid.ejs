<% if (staff) { %>
<div id="staffDetail" class="card" style="display:none;margin-top:1em"></div>
<script>
(function(){
  const DATA = <%- bookingsJson %>;
  const LVL = <%- levelsJson %>;
  const box = document.getElementById('staffDetail');
  const M2S = m => String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0');
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const levelColor = function(n){
    n = parseFloat(n);
    if (!(n >= 0)) return '#9a9aa6';
    if (n < 2.5) return '#34d399';
    if (n < 4) return '#a78bfa';
    if (n < 5) return '#fbbf24';
    return '#fb923c';
  };
  function card(b){
    const pls = b.players || [];
    const free = b.open_spots || 0;
    const kindLabel = { clase: 'Clase', torneo: 'Torneo', reserva: 'Reserva' }[b.kind] || 'Reserva';
    let h = '<h3>' + esc(b.court_name) + ' · ' + M2S(b.start_min) + '–' + M2S(b.end_min) + '</h3>';
    h += '<p class="mut" style="margin-top:-.4em">' + (free > 0 ? 'Partido abierto · faltan ' + free + (free === 1 ? ' jugador' : ' jugadores') : kindLabel + ' cerrada') + '</p>';
    h += '<ul>';
    for (const p of pls){
      const lv = (p.level !== undefined && p.level !== null && p.level !== '') ? p.level : LVL[p.member_number];
      h += '<li>' + esc(p.name) + (lv ? ' <span class="lchip" style="background:' + levelColor(lv) + '">' + esc(String(lv)) + '</span>' : '') + (p.is_guest ? ' <span class="mut">(invitado)</span>' : '') + '</li>';
    }
    for (let i = 0; i < free; i++) h += '<li><span class="mut">— plaza libre —</span></li>';
    h += '</ul>';
    h += '<p>' + (b.payment_status === 'paid' ? '<span class="badge ok">Pagado</span>' : b.payment_status === 'pending' ? '<span class="badge warn">Pago pendiente</span>' : '<span class="badge">Sin pago</span>') + '</p>';
    h += '<div class="row2" style="margin-top:.8em"><div>';
    h += '<a class="btn small ghost" href="<%= staffDay %>?date=<%= date %>">Ver el día completo</a>';
    h += '</div><div style="text-align:right">';
    h += '<form method="post" action="<%= anularPrefix %>' + b.id + '/anular" onsubmit="return confirm(\'¿Anular esta reserva?\')" style="display:inline">';
    h += '<input type="hidden" name="date" value="<%= date %>">';
    h += '<button class="btn small danger" type="submit">Anular</button></form>';
    h += '</div></div>';
    return h;
  }
  document.querySelectorAll('button.chip.busy[data-bid]').forEach(function(btn){
    btn.addEventListener('click', function(){
      const b = DATA.find(x => String(x.id) === btn.getAttribute('data-bid'));
      if (!b) return;
      box.innerHTML = card(b);
      box.style.display = 'block';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
})();
</script>
<% } %>
<% } %>

<% if (!staff) { %>
<details class="card" style="margin-top:1em">
  <summary class="mut" style="cursor:pointer">Avisadme si se libera una hora (lista de espera)</summary>
  <% if (member) { %>
  <form method="post" action="/reservar/espera" class="row2" style="margin-top:.5em">
    <input type="hidden" name="date" value="<%= date %>">
    <div class="field"><label>Pista</label><select name="court_id" id="w_court" required>
      <% for (const court of courts) { %><option value="<%= court.id %>"><%= court.name %></option><% } %>
    </select></div>
    <div class="field"><label>Hora deseada</label><select name="start_min" id="w_start" required></select></div>
    <div class="field"><label>Duración</label><select name="duration_min" required>
      <% for (const d of config.durations) { %><option value="<%= d %>" <%= d === 75 ? 'selected' : '' %>><%= d %> min</option><% } %>
    </select></div>
    <div class="field"><label>&nbsp;</label><button class="btn small" type="submit">Avisadme</button></div>
  </form>
  <script>
  const WS = <%- JSON.stringify(waitStarts) %>;
  const M2S = m => String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0');
  const wc = document.getElementById('w_court'), ws = document.getElementById('w_start');
  function fillW(){ ws.innerHTML = (WS[wc.value] || []).map(s => '<option value="'+s+'">'+M2S(s)+'</option>').join(''); }
  wc.addEventListener('change', fillW); fillW();
  </script>
  <% } else { %>
  <p class="mut"><a href="/reservar/entrar">Entra</a> para apuntarte a la lista de espera.</p>
  <% } %>
</details>
<% } %>

<% if (!staff && typeof chatEnabled !== 'undefined' && chatEnabled) { %><%- include('chat-widget') %><% } %>
<script>
(function(){
  var modal = document.getElementById('qModal');
  if (!modal) return;
  var isStaff = <%= staff ? 'true' : 'false' %>;
  var qSummary = document.getElementById('qSummary'),
      qForm = document.getElementById('qForm'),
      qCourt = document.getElementById('qCourt'),
      qStart = document.getElementById('qStart'),
      qDur = document.getElementById('qDur'),
      qAbrir = document.getElementById('qAbrir'),
      qOpen = document.getElementById('qOpen'),
      qFull = document.getElementById('qFull'),
      qCancel = document.getElementById('qCancel');
  function close(){ modal.style.display = 'none'; }
  qCancel.addEventListener('click', close);
  modal.addEventListener('click', function(e){ if (e.target === modal) close(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') close(); });
  qOpen.addEventListener('change', function(){ qAbrir.value = qOpen.checked ? '1' : '0'; });
  if (isStaff) {
    var qSearch = document.getElementById('qSearch'),
        qList = document.getElementById('qList'),
        qInfo = document.getElementById('qInfo'),
        qTitular = document.getElementById('qTitular');
    var searchBase = '<%= staff ? staffBase : "" %>/socios/buscar', timer = null;
    function paint(){
      var m = qTitular.value.trim();
      qInfo.innerHTML = m ? '<span class="pill">Socio ' + m + '</span>' : '';
    }
    function pick(no, name){
      qTitular.value = no; qSearch.value = name + ' (' + no + ')';
      qList.style.display = 'none'; paint();
    }
    qSearch.addEventListener('input', function(){
      qTitular.value = ''; paint();
      clearTimeout(timer);
      var q = qSearch.value.trim();
      if (q.length < 2) { qList.style.display = 'none'; return; }
      timer = setTimeout(function(){
        fetch(searchBase + '?q=' + encodeURIComponent(q))
          .then(function(r){ return r.json(); }).then(function(arr){
            if (!arr.length) { qList.style.display = 'none'; return; }
            qList.innerHTML = '';
            arr.forEach(function(s){
              var d = document.createElement('div');
              d.textContent = s.name + ' · socio ' + s.member_no + (s.phone ? ' · ' + s.phone : '');
              d.addEventListener('mousedown', function(){ pick(s.member_no, s.name); });
              qList.appendChild(d);
            });
            qList.style.display = '';
          })
          .catch(function(){ qInfo.innerHTML = '<span class="pill inv">No se pudo buscar: recarga la página</span>'; });
      }, 250);
    });
    qSearch.addEventListener('keydown', function(e){
      if (e.key === 'Enter') {
        var first = qList.querySelector('div');
        if (first && qList.style.display !== 'none') { e.preventDefault(); first.dispatchEvent(new Event('mousedown')); }
      }
    });
    qSearch.addEventListener('blur', function(){ setTimeout(function(){ qList.style.display = 'none'; }, 200); });
    document.querySelectorAll('.qrecent').forEach(function(ch){
      ch.addEventListener('click', function(){ pick(ch.dataset.no, ch.dataset.name); });
    });
    qForm.addEventListener('submit', function(e){
      if (!qTitular.value.trim()) { e.preventDefault(); qSearch.focus(); qInfo.innerHTML = '<span class="pill inv">Elige el titular</span>'; }
    });
  }
  document.querySelectorAll('a.chip.free').forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      var u = new URL(a.href, location.origin);
      qCourt.value = u.searchParams.get('court');
      qStart.value = u.searchParams.get('desde');
      qDur.value = u.searchParams.get('duracion');
      qSummary.textContent = a.dataset.cname + ' · ' + a.dataset.qdate + ' · ' + a.dataset.start + '–' + a.dataset.end + ' (' + u.searchParams.get('duracion') + ' min)';
      qFull.href = a.href;
      if (isStaff) {
        document.getElementById('qSearch').value = '';
        document.getElementById('qTitular').value = '';
        document.getElementById('qInfo').innerHTML = '';
        document.getElementById('qList').style.display = 'none';
      }
      modal.style.display = 'flex';
      if (isStaff) setTimeout(function(){ document.getElementById('qSearch').focus(); }, 60);
    });
  });
})();
</script>

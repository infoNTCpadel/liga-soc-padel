  <div class="qbox">
    <h3>Reserva rápida</h3>
    <p class="mut" id="qSummary" style="margin-top:0"></p>
    <div class="field">
      <label class="fl" for="qSearch">Titular</label>
      <div class="prow">
        <input type="text" id="qSearch" class="psearch" placeholder="Nombre, nº de socio o móvil…" autocomplete="off">
        <div class="plist" id="qList" style="display:none"></div>
        <div class="pinfo mut" id="qInfo" style="font-size:.85em"></div>

<div class="card" style="max-width: 440px; margin: 40px auto">
  <h2>Configuración inicial</h2>
  <p class="mut small">Crea la contraseña de la organización. La necesitarás para gestionar la liga.</p>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/admin/setup">
    <div class="field"><label>Contraseña</label><input type="password" name="password" required minlength="6"></div>
    <button class="btn" type="submit">Crear acceso</button>
  </form>
</div>

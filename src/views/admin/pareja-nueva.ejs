<h1>Añadir pareja manualmente</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card" style="max-width: 640px">
<form method="post" action="/admin/parejas/nueva">
  <div class="field"><label>Categoría</label>
    <% for (const c of CATEGORIES) { %><label><input type="radio" name="category" value="<%= c.code %>" <%= c.code==='M'?'checked':'' %>> <%= c.name %></label><% } %>
  </div>
  <% for (const n of [1,2]) { %>
  <h3>Jugador <%= n %></h3>
  <div class="row2">
    <div class="field"><label>Nombre *</label><input type="text" name="p<%= n %>_name" required></div>
    <div class="field"><label>Teléfono *</label><input type="tel" name="p<%= n %>_phone" required></div>
  </div>
  <div class="row2">
    <div class="field"><label>Email</label><input type="email" name="p<%= n %>_email"></div>
    <div class="field"><label>Nivel (0–6) *</label><input type="number" name="p<%= n %>_level" step="0.1" min="0" max="6" required></div>
  </div>
  <div class="field"><label>Sexo *</label>
    <select name="p<%= n %>_gender" required>
      <option value="">—</option>
      <option value="M">Hombre</option>
      <option value="F">Mujer</option>
    </select>
  </div>
  <div class="field"><label>Nº de socio del club *</label><input type="text" name="p<%= n %>_member" required></div>
  <div class="field"><label><input type="checkbox" name="p<%= n %>_paid" value="1"> Pagado</label></div>
  <% } %>
  <button class="btn" type="submit">Crear pareja activa</button>
</form>
</div>

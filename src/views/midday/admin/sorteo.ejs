<h1>MEDIODÍA PADEL · Sorteo y calendario · <%= sel.name %></h1>
<p><a class="btn ghost small" href="/admin/mediodia?t=<%= sel.id %>">← Volver a parejas</a></p>
<% if (info) { %><div class="alert ok"><%= info %></div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<% if (!draw) { %>
<div class="card">
  <h3>Generar sorteo</h3>
  <p class="mut">Parejas confirmadas en esta edición: <strong><%= approvedCount %></strong> (mínimo 4).</p>
  <% if (sel.status !== 'active') { %>
    <p class="alert error">La edición está en estado «<%= statusNames[sel.status] %>»: pásala a «En marcha» para generar el sorteo.</p>
  <% } else if (approvedCount < 4) { %>
    <p class="alert error">Faltan parejas confirmadas: se necesitan al menos 4.</p>
  <% } else { %>
    <p class="mut">Se reparten las parejas en 4 bombos por nivel, se generan las rondas (mínimo 6 partidos por pareja)
    y se propone un calendario respetando franjas, días vetados y descanso mínimo. Podrás revisarlo antes de publicarlo.</p>
    <form method="post" action="/admin/mediodia/sorteo/generar">
      <input type="hidden" name="t" value="<%= sel.id %>">
      <button class="btn big" type="submit">🎲 Generar sorteo</button>
    </form>
  <% } %>
</div>
<% } else { %>
<div class="card">
  <h3>Sorteo
    <% if (draw.status === 'published') { %><span class="badge ok">Publicado</span>
    <% } else { %><span class="badge warn">Borrador</span><% } %>
  </h3>
  <p class="mut small">
    <%= draw.params.approved || '' %> parejas ·
    <%= draw.params.rounds || '' %> rondas ·
    <%= (draw.params.legs || 1) === 2 ? 'ida y vuelta' : 'una vuelta' %> ·
    bombos <%= (draw.params.pots || []).join('-') %>
    <% if (draw.params.published_at) { %> · publicado el <%= draw.params.published_at.slice(0, 10).split('-').reverse().join('/') %><% } %>
  </p>
  <% if (draw.params.email_summary) { const es = draw.params.email_summary; %>
    <p class="mut small">📧 Emails al publicar: <%= es.sent %> enviados · <%= es.skipped %> omitidos<% if (es.failed) { %> · <%= es.failed %> con error<% } %><% if (es.testMode) { %> · <strong>modo pruebas → <%= es.testEmail %></strong><% } else if (!es.brevo) { %> (sin Brevo configurado)<% } %></p>
  <% } %>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <% if (draw.status === 'draft') { %>
      <form method="post" action="/admin/mediodia/sorteo/generar"
            onsubmit="return confirm('¿Regenerar el sorteo? Se descartará el borrador actual.')">
        <input type="hidden" name="t" value="<%= sel.id %>">
        <button class="btn ghost" type="submit">🎲 Regenerar</button>
      </form>
      <form method="post" action="/admin/mediodia/sorteo/publicar"
            onsubmit="return confirm('¿Publicar el calendario? Las parejas lo verán y se les avisará por email.')">
        <input type="hidden" name="t" value="<%= sel.id %>">
        <button class="btn big" type="submit">📢 Publicar calendario</button>
      </form>
    <% } %>
  </div>
</div>

<div class="card">
  <h3>Bombos por nivel</h3>
  <div class="row2" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
    <% for (const pot of pots) { %>
    <div>
      <h4 class="small">Bombo <%= pot.pot_no %></h4>
      <ul class="small" style="margin:0;padding-left:1.1em">
        <% for (const p of pot.pairs) { %>
        <li><%= p.player1_name %> / <%= p.player2_name %> <span class="mut">(<%= String(p.level_avg).replace('.', ',') %>)</span></li>
        <% } %>
      </ul>
    </div>
    <% } %>
  </div>
</div>

<% if (warnings && (warnings.unscheduled.length || warnings.hard.length || warnings.disputed.length)) { %>
<div class="card">
  <h3>⚠️ Avisos</h3>
  <% if (warnings.disputed.length) { %>
    <p class="mut"><strong><%= warnings.disputed.length %> resultado(s) disputado(s)</strong> por las parejas:</p>
    <ul class="small">
      <% for (const m of warnings.disputed) { %>
      <li>Ronda <%= m.round_no %>: <%= m.n1a %> / <%= m.n1b %> vs <%= m.n2a %> / <%= m.n2b %> · <strong><%= formatScore(m) %></strong>
        <form method="post" action="/admin/mediodia/sorteo/resultado/<%= m.id %>/resolver" style="display:inline">
          <input type="hidden" name="t" value="<%= sel.id %>">
          <button class="btn small" type="submit">Resolver (aceptar resultado)</button>
        </form>
      </li>
      <% } %>
    </ul>
  <% } %>
  <% if (warnings.unscheduled.length) { %>
    <p class="mut"><strong><%= warnings.unscheduled.length %> partido(s) sin programar</strong> (sin hueco válido en 12 semanas):</p>
    <ul class="small">
      <% for (const m of warnings.unscheduled) { %>
      <li>Ronda <%= m.round_no %>: <%= m.n1a %> / <%= m.n1b %> vs <%= m.n2a %> / <%= m.n2b %><br><span class="mut">→ <%= m.reason %></span></li>
      <% } %>
    </ul>
  <% } %>
  <% for (const h of warnings.hard) { %>
    <p class="mut">🔒 <strong><%= h.pair.player1_name %> / <%= h.pair.player2_name %></strong> <%= h.reason %>.</p>
  <% } %>
</div>
<% } %>

<div class="card">
  <h3>Calendario (<%= matches.length %> partidos)</h3>
  <% if (draw.status === 'draft') { %>
  <form method="post" action="/admin/mediodia/sorteo/guardar-todo">
  <input type="hidden" name="t" value="<%= sel.id %>">
  <p class="mut small">Rellena fecha, franja o pista en las filas que quieras cambiar y guárdalo todo de golpe. Las filas sin fecha se dejan como están.</p>
  <div style="display:flex;gap:10px;align-items:center;margin:8px 0;flex-wrap:wrap">
    <button class="btn" type="submit">Guardar todos los cambios</button>
    <label class="small"><input type="checkbox" name="force_all" value="1"> Forzar en las que choquen <span class="mut">(ya hablado con las parejas)</span></label>
    <% if (bulkSummary) { %><span class="small"><strong><%= bulkSummary %></strong></span><% } %>
  </div>
  <% } %>
  <% let lastRound = 0, lastSection = ''; %>
  <% for (const m of matches) { %>
    <% const section = m.match_date ? 'done' : 'pending'; %>
    <% if (section !== lastSection || m.round_no !== lastRound) { %>
      <% if (lastSection) { %></tbody></table><% } %>
      <% if (section !== lastSection) { %>
      <h4 class="small" style="margin-top:14px"><%= section === 'pending' ? '⏳ Pendientes de programar' : '✓ Programados' %></h4>
      <% } %>
      <p class="mut small" style="margin:6px 0 2px">Ronda <%= m.round_no %></p>
      <table class="tbl"><thead><tr>
        <th>Fecha</th><th>Franja</th><th>Pista</th><th>Pareja A</th><th></th><th>Pareja B</th>
        <% if (draw.status === 'draft') { %><th>Ajustar</th><% } %>
      </tr></thead><tbody>
    <% } %>
    <% lastSection = section; lastRound = m.round_no; %>
    <tr>
      <td><strong><%= fmtDate(m.match_date) %></strong>
        <% if (m.winner_id || m.wo_winner_id) { %><br><span class="small"><strong><%= formatScore(m) %></strong>
          <% if (m.validation === 'pending') { %> <span class="badge warn">pendiente</span><% } %>
          <% if (m.validation === 'disputed') { %> <span class="badge bad">disputado</span><% } %>
          <% if (m.validation === 'validated' || m.validation === 'auto') { %> <span class="badge ok">✓</span><% } %></span>
          <% if (draw.status !== 'draft') { %>
          <form method="post" action="/admin/mediodia/sorteo/resultado/<%= m.id %>/reabrir" style="display:inline" onsubmit="return confirm('¿Borrar el resultado y reabrir el partido?')">
            <input type="hidden" name="t" value="<%= sel.id %>">
            <button class="btn small ghost" type="submit" title="Borrar el resultado">Reabrir</button>
          </form>
          <% } %>
        <% } %>
        <% if (draw.status !== 'draft') { %><br>
        <button class="btn small ghost" onclick="document.getElementById('ar<%= m.id %>').style.display='table-row';this.style.display='none'" title="Poner o corregir el resultado">✎ Resultado</button>
        <% } %>
      </td>
      <td><%= slotLabel(m) %></td>
      <td><%= m.court_no ? 'Pista ' + m.court_no : '—' %></td>
      <td><%= m.n1a %> / <%= m.n1b %></td>
      <td class="mut">vs</td>
      <td><%= m.n2a %> / <%= m.n2b %></td>
      <% if (draw.status === 'draft') { %>
      <td>
        <div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap">
          <input type="date" name="date_<%= m.id %>" value="<%= m.match_date || '' %>" style="width:9.5em" title="Vacío = no cambiar">
          <select name="slot_<%= m.id %>">
            <% for (const s of settings.slots) { %>
            <option value="<%= s.id %>" <%= m.slot_id === s.id && !m.custom_time ? 'selected' : '' %>><%= s.label %></option>
            <% } %>
            <option value="__custom" <%= m.custom_time ? 'selected' : '' %>>Otra hora…</option>
          </select>
          <input type="time" name="ctime_<%= m.id %>" value="<%= m.custom_time || '' %>" style="width:6.5em" title="Hora libre: si escribes aquí se usa esta hora" oninput="this.form['slot_<%= m.id %>'].value='__custom'">
          <input type="number" name="court_<%= m.id %>" min="1" max="<%= settings.courts %>" value="<%= m.court_no || '' %>" placeholder="—" style="width:3.5em" title="Pista">
        </div>
        <% const br = (bulkResults || {})[m.id]; if (br) { %>
          <% if (br.ok) { %><span class="badge ok">✓ programado</span><% } else { %><span class="bad small">⚠ <%= br.error %></span><% } %>
        <% } %>
      </td>
      <% } %>
    </tr>
    <% if (draw.status !== 'draft') { %>
    <tr id="ar<%= m.id %>" style="display:none"><td colspan="6">
      <h4>Resultado · Ronda <%= m.round_no %>: <%= m.n1a %> / <%= m.n1b %> vs <%= m.n2a %> / <%= m.n2b %></h4>
      <p class="small mut">Columnas «Pareja A – Pareja B». Queda validado directamente.</p>
      <form method="post" action="/admin/mediodia/sorteo/resultado/<%= m.id %>/guardar">
        <input type="hidden" name="t" value="<%= sel.id %>">
        <div class="field"><label>Set 1 (A – B)</label><div class="scorein"><input type="number" name="s1a" min="0" max="7" value="<%= m.s1a == null ? '' : m.s1a %>"> <span>–</span> <input type="number" name="s1b" min="0" max="7" value="<%= m.s1b == null ? '' : m.s1b %>"></div></div>
        <div class="field"><label>Set 2 (A – B)</label><div class="scorein"><input type="number" name="s2a" min="0" max="7" value="<%= m.s2a == null ? '' : m.s2a %>"> <span>–</span> <input type="number" name="s2b" min="0" max="7" value="<%= m.s2b == null ? '' : m.s2b %>"></div></div>
        <div class="field"><label>Desempate</label>
          <select name="set3mode">
            <option value="none" <%= m.stb_a == null ? 'selected' : '' %>>No hubo (2 sets)</option>
            <option value="stb" <%= m.stb_a != null ? 'selected' : '' %>>Súper tie-break a 10</option>
          </select>
        </div>
        <div class="field"><label>Súper tie-break (A – B)</label><div class="scorein"><input type="number" name="s3a" min="0" max="30" value="<%= m.stb_a == null ? '' : m.stb_a %>"> <span>–</span> <input type="number" name="s3b" min="0" max="30" value="<%= m.stb_b == null ? '' : m.stb_b %>"></div></div>
        <div class="field"><label><input type="checkbox" name="wo" value="1"> W.O.</label>
          <label><input type="radio" name="wo_winner" value="<%= m.pair1_id %>"> a favor de A</label>
          <label><input type="radio" name="wo_winner" value="<%= m.pair2_id %>"> a favor de B</label>
        </div>
        <button class="btn small" type="submit">Guardar resultado</button>
      </form>
    </td></tr>
    <% } %>
  <% } %>
  <% if (matches.length) { %></tbody></table><% } %>
  <% if (draw.status === 'draft') { %>
  <div style="margin-top:10px">
    <button class="btn" type="submit">Guardar todos los cambios</button>
  </div>
  </form>
  <% } %>
</div>
<% } %>

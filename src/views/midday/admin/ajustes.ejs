<h1>MEDIODÍA PADEL · Ajustes · <%= sel.name %></h1>
<% if (info) { %><div class="alert ok"><%= info %></div><% } %>
<% if (errors.length) { %><div class="alert error"><ul><% for (const e of errors) { %><li><%= e %></li><% } %></ul></div><% } %>

<form method="post" action="/admin/mediodia/ajustes">
  <input type="hidden" name="t" value="<%= sel.id %>">
  <div class="card">
    <div class="field"><label>Nombre de la competición</label>
      <input type="text" name="comp_name" value="<%= form.comp_name %>"></div>
    <div class="field"><label>Franjas horarias <span class="hint">una por línea (p. ej. 13:00). Los cambios solo afectan a futuras inscripciones: las parejas ya inscritas guardan sus preferencias por franja.</span></label>
      <textarea name="slots_text" rows="3"><%= form.slots_text %></textarea></div>
    <div class="row2">
      <div class="field"><label><input type="checkbox" name="inscription_open" value="1" <%= form.inscription_open ? 'checked' : '' %>> Inscripción abierta</label></div>
      <div class="field"><label>Fecha límite de inscripción</label>
        <input type="date" name="inscription_deadline" value="<%= form.inscription_deadline %>"></div>
    </div>
    <div class="row2">
      <div class="field"><label>Nº de pistas disponibles al mediodía</label>
        <input type="number" name="courts_midday" min="1" max="20" value="<%= form.courts_midday %>"></div>
      <div class="field"><label>Días mínimos entre partidos de una pareja</label>
        <input type="number" name="min_days_between" min="0" max="30" value="<%= form.min_days_between %>"></div>
    </div>
  </div>
  <p><button class="btn big" type="submit">Guardar ajustes</button>
     <a class="btn ghost" href="/admin/mediodia?t=<%= sel.id %>">Volver a parejas</a></p>
</form>

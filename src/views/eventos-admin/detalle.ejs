<p class="small"><a href="/admin/eventos">← Eventos</a></p>
<h1><%= ev.name %></h1>
<p class="small">📅 <%= ev.event_date %><%= ev.event_time ? ' · ' + ev.event_time : '' %> ·
  <span class="badge cat"><%= modeName(ev.inscription_mode) %></span>
  <span class="badge <%= ev.status === 'abierta' ? 'ok' : ev.status === 'oculta' ? 'warn' : '' %>"><%= statusName(ev.status) %></span>
  <a href="/eventos/<%= ev.slug %>" target="_blank" rel="noopener">Ver landing →</a>
</p>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<div class="card">
  <h3>Estado del evento</h3>
  <form method="post" action="/admin/eventos/<%= ev.id %>/estado" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
    <div class="field" style="margin:0"><label>Estado</label>
      <select name="status"><% for (const k of Object.keys(statuses)) { %><option value="<%= k %>" <%= ev.status === k ? 'selected' : '' %>><%= statuses[k] %></option><% } %></select>
    </div>
    <button class="btn small" type="submit">Cambiar estado</button>
  </form>
  <p class="small mut">Abierta: se ve y admite inscripciones · En juego: se ve pero ya no admite · Cerrada: se ve sin inscribir · Finalizado: pasa a «Anteriores» · No visible: no se muestra en la web.</p>
</div>

<div class="card">
  <h3>Inscritos (<%= inscritos.length %>)<%= parejas ? ` · ${parejas} pareja(s)` : '' %><%= left !== null ? ` · ${left} plazas libres` : '' %></h3>
  <% if (inscritos.length) { %><p class="small">💶 Cobrado: <strong><%= eur(cobrado) %></strong> · Pendiente: <strong><%= eur(pendiente) %></strong><% if (hasDualPrice) { %> · <span class="mut">En cada inscrito puedes corregir Socio ↔ No socio y se le aplica su precio.</span><% } %></p><% } %>
  <p>
    <a class="btn small" href="/admin/eventos/<%= ev.id %>/csv">Exportar CSV</a>
    <form method="post" action="/admin/eventos/<%= ev.id %>/eliminar" style="display:inline" onsubmit="return confirm('¿Eliminar el evento y sus inscripciones?')"><button class="btn small danger" type="submit">Eliminar</button></form>
  </p>
  <% if (!inscritos.length) { %><p class="mut">Sin inscritos todavía.</p><% } else { %>
  <div class="tblwrap"><table class="tbl">
    <tr><th></th><th>Nombre</th><th>Pareja</th><th>Teléfono</th><th>Nivel</th><th>Nº socio</th><th>Precio</th><th>Pagado</th><th></th><th></th></tr>
    <% for (const r of inscritos) { %>
    <tr>
      <td><% if (!r.partner) { %><input type="checkbox" name="sel" value="<%= r.id %>" form="f-emparejar" title="Seleccionar para emparejar"><% } %></td>
      <td><strong><%= r.name %></strong><br><span class="mut small"><%= (r.created_at || '').slice(0, 16).replace('T', ' ') %></span></td>
      <td class="small">
        <% if (r.partner) { %>
          🤝 <%= r.partner.name %>
          <form method="post" action="/admin/eventos/<%= ev.id %>/inscripcion/<%= r.id %>/desemparejar" style="display:inline"><button class="btn small ghost" type="submit" title="Desemparejar">✕</button></form>
        <% } else { %><span class="mut">—</span><% } %>
      </td>
      <td class="small"><%= r.phone %></td>
      <td class="num"><%= r.level == null ? '—' : r.level %></td>
      <td class="small"><%= r.member_no %></td>
      <td class="small">
        <strong><%= eur(r.priceInfo.cents) %></strong>
        <% if (hasDualPrice) { %>
        <form method="post" action="/admin/eventos/<%= ev.id %>/inscripcion/<%= r.id %>/tipo" style="display:inline">
          <input type="hidden" name="member" value="<%= r.priceInfo.is_member ? '0' : '1' %>">
          <button class="btn small ghost" type="submit" title="Pulsa para cambiar entre socio y no socio"><%= r.priceInfo.is_member ? 'Socio' : 'No socio' %></button>
        </form>
        <% } %>
      </td>
      <td>
        <form method="post" action="/admin/eventos/<%= ev.id %>/inscripcion/<%= r.id %>/pagado" style="display:inline">
          <input type="hidden" name="paid" value="<%= r.paid ? '0' : '1' %>">
          <button class="btn small <%= r.paid ? '' : 'ghost' %>" type="submit"><%= r.paid ? '● cobrado' : '○ pdte.' %></button>
        </form>
      </td>
      <td><% if (r.wa) { %><a class="btn small ghost" href="<%= r.wa %>" target="_blank" rel="noopener">WhatsApp</a><% } %></td>
      <td>
        <form method="post" action="/admin/eventos/<%= ev.id %>/inscripcion/<%= r.id %>/eliminar" style="display:inline" onsubmit="return confirm('¿Dar de baja a <%= r.name %>?')"><button class="btn small danger" type="submit">Baja</button></form>
      </td>
    </tr>
    <% } %>
  </table></div>
  <form id="f-emparejar" method="post" action="/admin/eventos/<%= ev.id %>/emparejar">
    <p><button class="btn small" type="submit">Emparejar los 2 seleccionados</button>
    <span class="small mut">Para americanas: selecciona 2 inscritos sueltos y emparéjalos.</span></p>
  </form>
  <% } %>
</div>

<div class="card">
  <h3>Editar evento</h3>
  <form method="post" action="/admin/eventos/<%= ev.id %>/editar" enctype="multipart/form-data">
    <div class="field"><label>Nombre</label><input type="text" name="name" value="<%= ev.name %>" required></div>
    <div class="field"><label>Dirección web (slug) <span class="hint">(la landing es /eventos/<%= ev.slug %>; si la cambias, la antigua redirigirá a la nueva)</span></label><input type="text" name="slug" value="<%= ev.slug %>"></div>
    <div class="field"><label>Descripción</label><textarea name="description" rows="3"><%= ev.description %></textarea></div>
    <div class="field"><label>Cartel <span class="hint">(opcional; se reduce solo para que pese poco)</span></label>
      <% if (ev.poster) { %>
      <p><img src="/eventos/<%= ev.slug %>/poster" alt="Cartel actual" style="max-width:280px;height:auto;border-radius:8px"></p>
      <% } %>
      <input type="file" id="poster-input" name="poster" accept="image/*">
      <img id="poster-preview" alt="" style="display:none;max-width:280px;height:auto;margin-top:8px;border-radius:8px">
      <% if (ev.poster) { %>
      <p><button class="btn small ghost" type="submit" form="f-quitar-poster">Quitar cartel actual</button></p>
      <% } %>
    </div>
    <div class="row2">
      <div class="field"><label>Fecha</label><input type="date" name="event_date" value="<%= ev.event_date %>" required></div>
      <div class="field"><label>Hora</label><input type="time" name="event_time" value="<%= ev.event_time %>"></div>
    </div>
    <div class="row2">
      <div class="field"><label>Formato</label>
        <select name="format"><% for (const k of Object.keys(formats)) { %><option value="<%= k %>" <%= ev.format === k ? 'selected' : '' %>><%= formats[k] %></option><% } %></select>
      </div>
      <div class="field"><label>Precio socios (€)</label><input type="number" name="price" step="0.01" min="0" value="<%= (ev.price_cents / 100).toFixed(2) %>"></div>
    </div>
    <div class="field"><label>Precio no socios (€) <span class="hint">(vacío = mismo precio que socios)</span></label><input type="number" name="price_nonmember" step="0.01" min="0" placeholder="mismo que socios" value="<%= ev.price_nonmember_cents == null ? '' : (ev.price_nonmember_cents / 100).toFixed(2) %>"></div>
    <div class="row2">
      <div class="field"><label>Inscripción</label>
        <select name="mode"><% for (const k of Object.keys(modes)) { %><option value="<%= k %>" <%= ev.inscription_mode === k ? 'selected' : '' %>><%= modes[k] %></option><% } %></select>
      </div>
      <div class="field"><label>Estado</label>
        <select name="status"><% for (const k of Object.keys(statuses)) { %><option value="<%= k %>" <%= ev.status === k ? 'selected' : '' %>><%= statuses[k] %></option><% } %></select>
      </div>
    </div>
    <div class="field"><label>Plazas máximas <span class="hint">(0 = sin límite; se cuentan personas)</span></label><input type="number" name="max_players" min="0" value="<%= ev.max_players %>"></div>
    <button class="btn small" type="submit">Guardar cambios</button>
  </form>
  <% if (ev.poster) { %>
  <form id="f-quitar-poster" method="post" action="/admin/eventos/<%= ev.id %>/poster/quitar" style="display:none"></form>
  <% } %>
</div>
<script>
// Reduce el cartel en el navegador: máx 1200 px de ancho, JPG calidad 82.
document.getElementById('poster-input').addEventListener('change', async (e) => {
  const f = e.target.files[0];
  if (!f) return;
  try {
    const img = new Image();
    img.src = URL.createObjectURL(f);
    await img.decode();
    const scale = Math.min(1, 1200 / img.width);
    const c = document.createElement('canvas');
    c.width = Math.round(img.width * scale);
    c.height = Math.round(img.height * scale);
    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
    const blob = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.82));
    if (!blob) return;
    const dt = new DataTransfer();
    dt.items.add(new File([blob], 'cartel.jpg', { type: 'image/jpeg' }));
    e.target.files = dt.files;
    const pv = document.getElementById('poster-preview');
    pv.src = URL.createObjectURL(blob);
    pv.style.display = 'block';
  } catch (err) { /* se sube el original y el servidor valida */ }
});
</script>

<style>
.prow{position:relative}
.prow .psearch{width:100%;box-sizing:border-box}
.plist{position:absolute;z-index:30;left:0;right:0;background:var(--card2);color:var(--txt);border:1px solid var(--line);border-radius:8px;max-height:11em;overflow:auto;box-shadow:0 8px 20px rgba(0,0,0,.35)}
.plist>div{padding:.45em .6em;cursor:pointer}
.plist>div:hover{background:#2b351f}
.pill{display:inline-block;background:#2b351f;border:1px solid var(--lime);color:var(--lime);border-radius:999px;padding:0 .55em;font-size:.85em;margin-right:.3em}
.pill.inv{background:#3a2f14;border-color:var(--amber);color:var(--amber)}
</style>
<h1>Reservas · <%= date.slice(8,10) %>/<%= date.slice(5,7) %>/<%= date.slice(0,4) %></h1>
<% if (info) { %><div class="alert ok"><%= info %></div><% } %>

<div class="card">
  <a class="btn small ghost" href="/recepcion/reservas?date=<%= prev %>">← Día anterior</a>
  <a class="btn small ghost" href="/recepcion/reservas?date=<%= next %>">Día siguiente →</a>
  <a class="btn small" href="/recepcion/reservas/nueva?date=<%= date %>" style="margin-left:.6em">+ Nueva reserva</a>
  <a class="btn small ghost" href="/recepcion/reservas/parrilla?date=<%= date %>" style="margin-left:.4em">Parrilla visual</a>
</div>

<% if (pending.length) { %>
<div class="card">
  <h3 style="color:#a33">Pendientes de pago en recepción (<%= pending.length %>)</h3>
  <% for (const b of pending) { %>
  <div class="card">
    <p><strong><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></strong> · <%= b.court_name %> · Titular: <%= b.titular_name %> (socio <%= b.titular_member_no %>)</p>
    <p class="mut">Jugadores: <%= b.players.map(p => p.name + (p.is_guest ? ' (invitado)' : ' (socio ' + p.member_no + ')')).join(' · ') %></p>
    <form method="post" action="/recepcion/reservas/<%= b.id %>/pago" style="display:inline">
      <input type="hidden" name="paid" value="1"><button class="btn small" type="submit">Marcar pagado</button>
    </form>
    <form method="post" action="/recepcion/reservas/<%= b.id %>/cargo" style="display:inline;margin-left:.5em">
      <input type="text" name="label" placeholder="Cargo extra (p. ej. luz)" size="18" required>
      <input type="text" name="amount" placeholder="€" size="5" required>
      <button class="btn small ghost" type="submit">Añadir cargo</button>
    </form>
  </div>
  <% } %>
</div>
<% } %>

<% if (unpaidCharges.length) { %>
<div class="card">
  <h3>Cargos extra sin cobrar</h3>
  <table class="tbl"><tr><th>Hora</th><th>Pista</th><th>Concepto</th><th>Importe</th><th></th></tr>
  <% for (const ch of unpaidCharges) { %>
  <tr><td><%= minToStr(ch.booking.start_min) %></td><td><%= ch.booking.court_name %></td>
    <td><%= ch.label %></td><td><%= eur(ch.amount_cents) %></td>
    <td><form method="post" action="/recepcion/reservas/cargos/<%= ch.id %>/pagado" style="display:inline">
      <input type="hidden" name="paid" value="1"><button class="btn small" type="submit">Cobrado</button></form></td></tr>
  <% } %>
  </table>
</div>
<% } %>

<div class="card">
  <h3>Todas las reservas del día</h3>
  <table class="tbl">
    <tr><th>Hora</th><th>Pista</th><th>Titular</th><th>Jugadores</th><th>Pago</th><th></th></tr>
    <% for (const b of bookings) { %>
    <tr style="<%= b.status==='cancelled' ? 'opacity:.45' : '' %>">
      <td><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></td>
      <td><%= b.court_name %></td>
      <td><%= b.titular_name %></td>
      <td class="mut"><%= b.players.map(p => p.name + (p.is_guest ? '*' : '')).join(', ') %><%= b.players.some(p=>p.is_guest) ? ' (* = invitado)' : '' %>
        <% if (b.status === 'active') { %>
        <details style="margin-top:.3em">
          <summary style="cursor:pointer;font-size:.85em">Completar jugadores</summary>
          <form method="post" action="/recepcion/reservas/<%= b.id %>/jugadores" style="margin-top:.3em">
            <% for (let i = 0; i < 3; i++) { const p = b.players[i + 1]; %>
            <div class="prow" style="margin-bottom:.35em">
              <input type="text" class="psearch" placeholder="Buscar socio por nombre, nº o móvil…" autocomplete="off" value="<%= p ? p.name + (p.member_no ? ' (' + p.member_no + ')' : '') : '' %>">
              <input type="hidden" class="pname" name="p<%= i + 1 %>_name" value="<%= p ? p.name : '' %>">
              <input type="hidden" class="pmember" name="p<%= i + 1 %>_member" value="<%= p ? p.member_no : '' %>">
              <div class="plist" style="display:none"></div>
              <div class="pinfo mut" style="font-size:.85em"></div>
            </div>
            <% } %>
            <button class="btn small ghost" type="submit">Guardar</button>
          </form>
        </details>
        <% } %>
      </td>
      <td><%- b.status === 'cancelled' ? '<span class="mut">Anulada</span>' : (b.payment_status === 'pending' ? '<span class="badge warn">Pendiente</span>' : b.payment_status === 'paid' ? '<span class="badge ok">Pagado</span>' : '<span class="badge ok">OK</span>') %><% if (b.open_spots > 0) { %><br><span class="badge" style="background:#e9f7ef;color:#146c39">Abierto · <%= b.open_spots %></span><% } %></td>
      <td><% if (b.status === 'active') { %>
        <form method="post" action="/recepcion/reservas/<%= b.id %>/anular" style="display:inline" onsubmit="return confirm('¿Anular esta reserva?')">
          <button class="btn small danger" type="submit">Anular</button></form>
      <% } %></td>
    </tr>
    <% } %>
  </table>
  <% if (!bookings.length) { %><p class="mut">No hay reservas este día.</p><% } %>
  <% if (blocks.length) { %><p class="hint">Bloqueos: <%= blocks.map(b => b.court_name + ' ' + minToStr(b.start_min) + '–' + minToStr(b.end_min) + ' (' + b.reason + ')').join(' · ') %></p><% } %>
</div>
<script>
(function(){
  const searchBase = '/recepcion/reservas/socios/buscar';
  let timer = null;
  document.querySelectorAll('.prow').forEach(row => {
    const input = row.querySelector('.psearch'), list = row.querySelector('.plist'),
      hname = row.querySelector('.pname'), hmem = row.querySelector('.pmember'),
      info = row.querySelector('.pinfo');
    function paint() {
      const n = hname.value.trim(), m = hmem.value.trim();
      if (!n) { info.innerHTML = ''; return; }
      info.innerHTML = m ? '<span class="pill">Socio ' + m + '</span>' : '<span class="pill inv">Invitado</span>';
    }
    function pick(s) {
      hname.value = s.name; hmem.value = s.member_no;
      input.value = s.name + ' (' + s.member_no + ')';
      list.style.display = 'none'; paint();
    }
    input.addEventListener('input', () => {
      hname.value = input.value.trim(); hmem.value = ''; paint();
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) { list.style.display = 'none'; return; }
      timer = setTimeout(() => {
        fetch(searchBase + '?q=' + encodeURIComponent(q))
          .then(r => r.json()).then(arr => {
            if (!arr.length) { list.style.display = 'none'; return; }
            list.innerHTML = '';
            arr.forEach(s => {
              const d = document.createElement('div');
              d.textContent = s.name + ' · socio ' + s.member_no + (s.phone ? ' · ' + s.phone : '');
              d.addEventListener('mousedown', () => pick(s));
              list.appendChild(d);
            });
            list.style.display = '';
          })
          .catch(() => { info.innerHTML = '<span class="pill inv">No se pudo buscar: recarga la página</span>'; });
      }, 250);
    });
    input.addEventListener('blur', () => setTimeout(() => list.style.display = 'none', 200));
    input.addEventListener('focus', () => { if (list.children.length) list.style.display = ''; });
    paint();
  });
})();
</script>

<h1>Recepción — verificación de socios</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (!noPass) { %>
<div class="card" style="max-width: 420px">
  <form method="post" action="/recepcion/login">
    <div class="field"><label>Contraseña de recepción</label><input type="password" name="password" required autofocus></div>
    <button class="btn" type="submit">Entrar</button>
  </form>
</div>
<% } %>

<style>
.prow{position:relative}
.prow .psearch{width:100%;box-sizing:border-box}
.plist{position:absolute;z-index:30;left:0;right:0;background:var(--card2);color:var(--txt);border:1px solid var(--line);border-radius:8px;max-height:11em;overflow:auto;box-shadow:0 8px 20px rgba(0,0,0,.35)}
.plist>div{padding:.45em .6em;cursor:pointer}
.plist>div:hover{background:#2b351f}
.pill{display:inline-block;background:#2b351f;border:1px solid var(--lime);color:var(--lime);border-radius:999px;padding:0 .55em;font-size:.85em;margin-right:.3em}
.pill.inv{background:#3a2f14;border-color:var(--amber);color:var(--amber)}
.dot{font-size:1.1em;line-height:1}
.dot.warn{color:#d9a441}
.dot.ok{color:#2f9e5f}
.preset{white-space:nowrap}
.ellipsis{display:block;max-width:20em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
</style>
<h1>Reservas · <%= date.slice(8,10) %>/<%= date.slice(5,7) %>/<%= date.slice(0,4) %></h1>
<% if (info) { %><div class="alert ok"><%= info %></div><% } %>

<% const incompletas = bookings.filter(b => b.status === 'active' && !(b.open_spots > 0) && b.players.length < 4); %>
<% if (incompletas.length) { %>
<div class="card" style="border:1px solid var(--amber)">
  <h3 style="color:var(--amber)">⚠ Cerradas con jugadores incompletos (<%= incompletas.length %>)</h3>
  <p class="mut">Partidos cerrados con menos de 4 jugadores. El socio puede abrirlos desde «Mis reservas», o puedes abrirlos tú para buscar jugadores:</p>
  <table class="tbl"><tr><th>Hora</th><th>Pista</th><th>Titular</th><th>Jugadores</th><th></th></tr>
  <% for (const b of incompletas) { %>
    <tr><td><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></td><td><%= b.court_name %></td><td><%= b.titular_name %></td><td><%= b.players.length %>/4</td>
    <td><form method="post" action="/admin/reservas/reservas/<%= b.id %>/abrir" style="display:inline"><button class="btn small" type="submit">Abrir</button></form></td></tr>
  <% } %>
  </table>
</div>
<% } %>

<div class="card">
  <a class="btn small ghost" href="/admin/reservas/dia?date=<%= prev %>">← Día anterior</a>
  <a class="btn small ghost" href="/admin/reservas/dia?date=<%= next %>">Día siguiente →</a>
  <a class="btn small" href="/admin/reservas/nueva?date=<%= date %>" style="margin-left:.6em">+ Nueva reserva</a>
  <a class="btn small ghost" href="/admin/reservas/parrilla?date=<%= date %>" style="margin-left:.4em">Parrilla visual</a>
  <span class="mut" style="margin-left:1em"><a href="/admin/reservas/config">Configuración</a> · <a href="/admin/reservas/socios">Socios</a> · <a href="/admin/reservas/bloqueos">Bloqueos</a></span>
</div>

<% if (blocks.length) { %>
<div class="card"><h3>Bloqueos</h3>
<table class="tbl"><tr><th>Pista</th><th>Tramo</th><th>Motivo</th></tr>
<% for (const b of blocks) { %><tr><td><%= b.court_name %></td><td><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></td><td><%= b.reason %><%= b.notes ? ' · ' + b.notes : '' %></td></tr><% } %>
</table></div>
<% } %>

<div class="card">
  <h3>Reservas (<%= bookings.filter(b=>b.status==='active').length %>)</h3>
  <table class="tbl">
    <tr><th>Hora</th><th>Pista</th><th>Titular</th><th>Jugadores</th><th>Pago</th><th>Cargos</th><th></th></tr>
    <% for (const b of bookings) { const _up = b.charges.filter(c => !c.paid); %>
    <tr style="<%= b.status==='cancelled' ? 'opacity:.45' : '' %>">
      <td style="white-space:nowrap"><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></td>
      <td style="white-space:nowrap"><%= b.court_name %></td>
      <td><%= b.titular_name %><br><span class="mut" style="font-size:.85em">socio <%= b.titular_member_no %></span>
        <% if (b.open_spots > 0) { %><br><span class="badge" style="background:#e9f7ef;color:#146c39">Abierto · <%= b.open_spots %></span><% } %></td>
      <td><strong><%= b.players.length %>/4</strong><br><span class="mut ellipsis" style="font-size:.85em" title="<%= b.players.map(p => p.name).join(', ') %>"><%= b.players.map(p => p.name + (p.is_guest ? ' (inv.)' : '')).join(' · ') %></span></td>
      <td style="white-space:nowrap"><%- b.status === 'cancelled' ? '<span class="mut">Anulada</span>' : b.payment_status === 'pending' ? '<span class="badge warn">Pendiente</span>' : b.payment_status === 'paid' ? '<span class="badge ok">Pagado</span>' : '<span class="badge ok">OK</span>' %></td>
      <td style="white-space:nowrap"><% if (_up.length) { %><span class="dot warn" title="<%= _up.length %> cargo(s) pendiente(s)">●</span> <span class="mut" style="font-size:.85em"><%= _up.length %> pdte.</span><% } else if (b.charges.length) { %><span class="dot ok" title="Todo cobrado">●</span><% } else { %><span class="mut">—</span><% } %></td>
      <td style="white-space:nowrap"><% if (b.status === 'active') { %><a class="btn small" href="/admin/reservas/reservas/<%= b.id %>">Ficha →</a><% } %></td>
    </tr>
    <% } %>
  </table>
  <% if (!bookings.length) { %><p class="mut">No hay reservas este día.</p><% } %>
</div>

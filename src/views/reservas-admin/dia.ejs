<style>
.prow{position:relative}
.prow .psearch{width:100%;box-sizing:border-box}
.plist{position:absolute;z-index:30;left:0;right:0;background:var(--card2);color:var(--txt);border:1px solid var(--line);border-radius:8px;max-height:11em;overflow:auto;box-shadow:0 8px 20px rgba(0,0,0,.35)}
.plist>div{padding:.45em .6em;cursor:pointer}
.plist>div:hover{background:#2b351f}
.pill{display:inline-block;background:#2b351f;border:1px solid var(--lime);color:var(--lime);border-radius:999px;padding:0 .55em;font-size:.85em;margin-right:.3em}
.pill.inv{background:#3a2f14;border-color:var(--amber);color:var(--amber)}
</style>
<h1>Reservas · <%= date.slice(8,10) %>/<%= date.slice(5,7) %>/<%= date.slice(0,4) %></h1>
<% if (info) { %><div class="alert ok"><%= info %></div><% } %>

<% const incompletas = bookings.filter(b => b.status === 'active' && !(b.open_spots > 0) && b.players.length < 4); %>
<% if (incompletas.length) { %>
<div class="card" style="border:1px solid var(--amber)">
  <h3 style="color:var(--amber)">⚠ Cerradas con jugadores incompletos (<%= incompletas.length %>)</h3>
  <p class="mut">Partidos cerrados con menos de 4 jugadores. El socio puede abrirlos desde «Mis reservas», o puedes abrirlos tú para buscar jugadores:</p>
  <table class="tbl"><tr><th>Hora</th><th>Pista</th><th>Titular</th><th>Jugadores</th><th></th></tr>
  <% for (const b of incompletas) { %>
    <tr><td><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></td><td><%= b.court_name %></td><td><%= b.titular_name %></td><td><%= b.players.length %>/4</td>
    <td><form method="post" action="/admin/reservas/reservas/<%= b.id %>/abrir" style="display:inline"><button class="btn small" type="submit">Abrir</button></form></td></tr>
  <% } %>
  </table>
</div>
<% } %>

<div class="card">
  <a class="btn small ghost" href="/admin/reservas/dia?date=<%= prev %>">← Día anterior</a>
  <a class="btn small ghost" href="/admin/reservas/dia?date=<%= next %>">Día siguiente →</a>
  <a class="btn small" href="/admin/reservas/nueva?date=<%= date %>" style="margin-left:.6em">+ Nueva reserva</a>
  <a class="btn small ghost" href="/admin/reservas/parrilla?date=<%= date %>" style="margin-left:.4em">Parrilla visual</a>
  <span class="mut" style="margin-left:1em"><a href="/admin/reservas/config">Configuración</a> · <a href="/admin/reservas/socios">Socios</a> · <a href="/admin/reservas/bloqueos">Bloqueos</a></span>
</div>

<% if (blocks.length) { %>
<div class="card"><h3>Bloqueos</h3>
<table class="tbl"><tr><th>Pista</th><th>Tramo</th><th>Motivo</th></tr>
<% for (const b of blocks) { %><tr><td><%= b.court_name %></td><td><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></td><td><%= b.reason %><%= b.notes ? ' · ' + b.notes : '' %></td></tr><% } %>
</table></div>
<% } %>

<div class="card">
  <h3>Reservas (<%= bookings.filter(b=>b.status==='active').length %>)</h3>
  <table class="tbl">
    <tr><th>Hora</th><th>Pista</th><th>Titular</th><th>Jugadores</th><th>Pago</th><th>Cargos</th><th></th></tr>
    <% for (const b of bookings) { %>
    <tr style="<%= b.status==='cancelled' ? 'opacity:.45' : '' %>">
      <td><%= minToStr(b.start_min) %>–<%= minToStr(b.end_min) %></td>
      <td><%= b.court_name %></td>
      <td><%= b.titular_name %><br><span class="mut">socio <%= b.titular_member_no %></span>
        <% if (b.open_spots > 0) { %><br><span class="badge" style="background:#e9f7ef;color:#146c39">Abierto · <%= b.open_spots %> <%= b.open_spots === 1 ? 'plaza' : 'plazas' %></span><% } %></td>
      <td><% for (const p of b.players) { %><%= p.name %><%- p.is_guest ? ' <span class="badge warn">inv.</span>' : '' %><br><% } %>
        <% if (b.status === 'active') { %>
        <details style="margin-top:.3em">
          <summary class="mut" style="cursor:pointer;font-size:.85em">Completar jugadores</summary>
          <form method="post" action="/admin/reservas/reservas/<%= b.id %>/jugadores" style="margin-top:.3em">
            <% for (let i = 0; i < 3; i++) { const p = b.players[i + 1]; %>
            <div class="prow" style="margin-bottom:.35em">
              <input type="text" class="psearch" placeholder="Buscar socio por nombre, nº o móvil…" autocomplete="off" value="<%= p ? p.name + (p.member_no ? ' (' + p.member_no + ')' : '') : '' %>">
              <input type="hidden" class="pname" name="p<%= i + 1 %>_name" value="<%= p ? p.name : '' %>">
              <input type="hidden" class="pmember" name="p<%= i + 1 %>_member" value="<%= p ? p.member_no : '' %>">
              <div class="plist" style="display:none"></div>
              <div class="pinfo mut" style="font-size:.85em"></div>
            </div>
            <% } %>
            <button class="btn small ghost" type="submit">Guardar</button>
          </form>
        </details>
        <% } %>
      </td>
      <td>
        <% if (b.status === 'active') { %>
          <%- b.payment_status === 'pending' ? '<span class="badge warn">Pendiente</span>' : b.payment_status === 'paid' ? '<span class="badge ok">Pagado</span>' : '<span class="badge ok">OK</span>' %>
          <% if (b.payment_status === 'pending' || b.payment_status === 'paid') { %>
          <form method="post" action="/admin/reservas/reservas/<%= b.id %>/pago" style="margin-top:.3em">
            <input type="hidden" name="paid" value="<%= b.payment_status === 'pending' ? '1' : '0' %>">
            <button class="btn small ghost" type="submit"><%= b.payment_status === 'pending' ? 'Marcar pagado' : 'Marcar pendiente' %></button>
          </form>
          <% } %>
        <% } else { %><span class="mut">Anulada</span><% } %>
      </td>
      <td>
        <% for (const ch of b.charges) { %>
          <%= ch.label %> · <%= eur(ch.amount_cents) %><%= ch.player_name ? ' → ' + ch.player_name : '' %> <%- ch.paid ? '<span class="badge ok">pagado</span>' : '<span class="badge warn">pdte.</span>' %><br>
        <% } %>
        <% if (b.status === 'active') { %>
        <form method="post" action="/admin/reservas/reservas/<%= b.id %>/cargo" style="margin-top:.3em">
          <input type="text" name="label" placeholder="Concepto (p. ej. luz)" size="12" required>
          <input type="text" name="amount" placeholder="€" size="5" required>
          <button class="btn small ghost" type="submit">+</button>
        </form>
        <% } %>
      </td>
      <td>
        <% if (b.status === 'active') { %>
        <form method="post" action="/admin/reservas/reservas/<%= b.id %>/anular" onsubmit="return confirm('¿Anular esta reserva?')" style="display:inline">
          <button class="btn small danger" type="submit">Anular</button>
        </form>
        <% for (const ch of b.charges.filter(c=>!c.paid)) { %>
        <form method="post" action="/admin/reservas/cargos/<%= ch.id %>/pagado" style="display:inline">
          <input type="hidden" name="paid" value="1"><button class="btn small ghost" type="submit" title="Marcar pagado: <%= ch.label %>">Cobrar <%= eur(ch.amount_cents) %></button>
        </form>
        <% } %>
        <% } %>
      </td>
    </tr>
    <% } %>
  </table>
  <% if (!bookings.length) { %><p class="mut">No hay reservas este día.</p><% } %>
</div>
<script>
(function(){
  const searchBase = '/admin/reservas/socios/buscar';
  let timer = null;
  document.querySelectorAll('.prow').forEach(row => {
    const input = row.querySelector('.psearch'), list = row.querySelector('.plist'),
      hname = row.querySelector('.pname'), hmem = row.querySelector('.pmember'),
      info = row.querySelector('.pinfo');
    function paint() {
      const n = hname.value.trim(), m = hmem.value.trim();
      if (!n) { info.innerHTML = ''; return; }
      info.innerHTML = m ? '<span class="pill">Socio ' + m + '</span>' : '<span class="pill inv">Invitado</span>';
    }
    function pick(s) {
      hname.value = s.name; hmem.value = s.member_no;
      input.value = s.name + ' (' + s.member_no + ')';
      list.style.display = 'none'; paint();
    }
    input.addEventListener('input', () => {
      hname.value = input.value.trim(); hmem.value = ''; paint();
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) { list.style.display = 'none'; return; }
      timer = setTimeout(() => {
        fetch(searchBase + '?q=' + encodeURIComponent(q))
          .then(r => r.json()).then(arr => {
            if (!arr.length) { list.style.display = 'none'; return; }
            list.innerHTML = '';
            arr.forEach(s => {
              const d = document.createElement('div');
              d.textContent = s.name + ' · socio ' + s.member_no + (s.phone ? ' · ' + s.phone : '');
              d.addEventListener('mousedown', () => pick(s));
              list.appendChild(d);
            });
            list.style.display = '';
          })
          .catch(() => { info.innerHTML = '<span class="pill inv">No se pudo buscar: recarga la página</span>'; });
      }, 250);
    });
    input.addEventListener('blur', () => setTimeout(() => list.style.display = 'none', 200));
    input.addEventListener('focus', () => { if (list.children.length) list.style.display = ''; });
    paint();
  });
})();
</script>

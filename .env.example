# Copia este archivo como ".env" y cambia el valor.
# Cadena larga y secreta para firmar las sesiones (cámbiala en producción).
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Dominio propio de la competición de mediodía (MEDIODÍA PADEL).
#MIDDAY_HOST=kanbe-mediodia.padelvalles.com
# Email vía Brevo (aviso de calendario publicado en Mediodía + recordatorios de reservas).
# Sin estas dos variables, los envíos se omiten sin romper nada.
#BREVO_API_KEY=<redacted>
#MAIL_FROM=info@example.com
# Para probar el envío sin mandar correos reales: vuelca los emails a un fichero (una línea JSON por email).
#MIDDAY_EMAIL_LOG=/tmp/midday-emails.log
